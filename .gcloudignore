.gcloudignore
.git
.gitignore
# dist/firmware/ must exist for the deb and server Dockerfiles (COPY), so
# upload its placeholder file (but no staged firmware).
dist/*
!dist/firmware/
dist/firmware/*
!dist/firmware/.keep
node_modules/
src/generated/
src/ui/node_modules/
build_err.log
build_out.log
push.sh
