{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "diagnoseme": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/diagnoseme",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/deeppurple-amber.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2000kb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "12kb"
                }
              ],
              "outputHashing": "all"
            },
            "all": {
              "fileReplacements": [
                {
                  "replace": "src/app/editions/active-edition.ts",
                  "with": "src/app/editions/active-edition.all.ts"
                }
              ]
            },
            "dolos": {
              "fileReplacements": [
                {
                  "replace": "src/app/editions/active-edition.ts",
                  "with": "src/app/editions/active-edition.dolos.ts"
                }
              ]
            },
            "servo-v4p1": {
              "fileReplacements": [
                {
                  "replace": "src/app/editions/active-edition.ts",
                  "with": "src/app/editions/active-edition.servo-v4p1.ts"
                }
              ]
            },
            "servo-micro": {
              "fileReplacements": [
                {
                  "replace": "src/app/editions/active-edition.ts",
                  "with": "src/app/editions/active-edition.servo-micro.ts"
                }
              ]
            },
            "maui-v1.1": {
              "fileReplacements": [
                {
                  "replace": "src/app/editions/active-edition.ts",
                  "with": "src/app/editions/active-edition.maui-v1.1.ts"
                }
              ]
            },
            "maui-v1.2": {
              "fileReplacements": [
                {
                  "replace": "src/app/editions/active-edition.ts",
                  "with": "src/app/editions/active-edition.maui-v1.2.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "diagnoseme:build:production"
            },
            "development": {
              "buildTarget": "diagnoseme:build:development"
            }
          },
          "defaultConfiguration": "development",
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "diagnoseme:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "karmaConfig": "karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/deeppurple-amber.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },

}
