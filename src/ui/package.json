{
  "name": "diagnoseme",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "proto:generate": "cd ../.. && npx protoc --plugin=protoc-gen-ng=$(which protoc-gen-ng) --ng_out=./src/ui/src/proto -I ./src/common/protos ./src/common/protos/*.proto",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.1",
    "@angular/compiler": "^21.1.1",
    "@angular/core": "^21.1.1",
    "@angular/forms": "^21.1.1",
    "@angular/material": "^21.1.1",
    "@angular/platform-browser": "^21.1.1",
    "@angular/platform-browser-dynamic": "^21.1.1",
    "@angular/router": "^21.1.1",
    "@grpc/proto-loader": "^0.8.0",
    "@ngx-grpc/common": "^5.0.0",
    "@ngx-grpc/core": "^5.0.0",
    "@ngx-grpc/grpc-web-client": "^5.0.0",
    "@ngx-grpc/well-known-types": "^5.0.0",
    "file-saver": "^2.0.5",
    "google-protobuf": "^4.0.1",
    "grpc-web": "^2.0.2",
    "jszip": "^3.10.1",
    "ngx-mat-select-search": "^8.0.4",
    "protoc": "^33.4.0",
    "rxjs": "~7.8.2",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.1",
    "@ngx-grpc/protoc-gen-ng": "^5.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/google-protobuf": "^3.15.12",
    "@types/jasmine": "~5.1.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^25.0.10",
    "eslint-plugin-prettier": "^5.5.5",
    "gts": "^6.0.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
