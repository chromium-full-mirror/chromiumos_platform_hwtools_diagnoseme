    "@types/google-protobuf": "^3.15.12",
    "@types/jasmine": "~5.1.8",
    "@types/node": "^24.0.1",
    "gts": "^6.0.2",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
