"""Downloads the latest stable Maui MCU and PDC firmware from GCS.

The public gs://maui-firmware bucket marks the stable release of each
component with an empty marker object named `stable.<device>.<kind>` next to
the firmware file, e.g.

  mcu-fw/mspm0/0.60-042f858/stable.maui_v11.mcufw
  mcu-fw/mspm0/0.60-042f858/zephyr.txt

For every component the marker is resolved and the single firmware file with
the component extension in the marker directory is downloaded. If the
directory holds several such files, one is picked deterministically (see
pick_firmware_key) and a warning is printed.

<dest>/<subdir> is replaced as a whole: the firmware is downloaded into a
temporary directory next to it, which is then swapped in, so stale files of
older releases are removed and an interrupted download leaves the previous
firmware in place. Next to the firmware the directory gets a STABLE.json:

  {"version": "<marker dir basename>", "file": "<file name>",
   "md5": "<hex>", "source": "gs://maui-firmware/<key>"}

which the DiagnoseMe server uses to pick the exact firmware file. When the
existing STABLE.json already names the same version and MD5 (and the file is
intact), nothing is downloaded.

This script uses only the Python standard library. It is shipped in the
diagnoseme deb (used by start-diagnoseme) and used from the repository by the
offline bundle and ISO builders.

Exit status: 0 if every component is up to date, 1 otherwise.
Callers decide whether a failure is fatal.
"""

import argparse
import base64
import binascii
import dataclasses
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
from typing import Dict
from typing import Iterator
from typing import List
from typing import Optional
from typing import Tuple
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET


BUCKET = "maui-firmware"
GCS_BASE_URL = f"https://storage.googleapis.com/{BUCKET}"
USER_AGENT = "DiagnoseMe-FirmwareFetcher"
DEFAULT_DEVICE = "maui_v11"
DEFAULT_LIST_TIMEOUT_S = 15
DEFAULT_DOWNLOAD_TIMEOUT_S = 30
DOWNLOAD_CHUNK_BYTES = 1 << 20
STABLE_INFO_FILE = "STABLE.json"
MD5_HEX_RE = re.compile(r"^[0-9a-f]{32}$")


@dataclasses.dataclass(frozen=True)
class Component:
    """A firmware component stored in the bucket."""

    name: str  # Human readable name used in log messages.
    prefix: str  # Bucket prefix that is searched for the marker.
    marker_kind: str  # Marker suffix, e.g. "mcufw" in stable.maui_v11.mcufw.
    file_ext: str  # Extension of the firmware file to download.
    subdir: str  # Subdirectory of --dest that receives the file.
    # File names preferred (in this order) when the marker directory holds
    # several files with file_ext. "{version}" is the marker dir basename.
    preferred_names: Tuple[str, ...] = ()


COMPONENTS = (
    Component("MCU", "mcu-fw", "mcufw", ".txt", "mcu", ("zephyr.txt",)),
    Component("PDC", "pdc-fw", "pdcfw", ".bin", "pdc", ("{version}.bin", "pdc.bin")),
)


@dataclasses.dataclass(frozen=True)
class ObjectInfo:
    """A bucket object as returned by the XML list API."""

    key: str
    etag: str


class FetchError(Exception):
    """Raised when a component cannot be resolved or downloaded."""


def _log(msg: str) -> None:
    print(msg, flush=True)


def _warn(msg: str) -> None:
    print(f"WARNING: {msg}", file=sys.stderr, flush=True)


def _open(url: str, timeout: int, method: Optional[str] = None):
    request = urllib.request.Request(
        url, headers={"User-Agent": USER_AGENT}, method=method
    )
    return urllib.request.urlopen(request, timeout=timeout)


def _object_url(key: str) -> str:
    return f"{GCS_BASE_URL}/{urllib.parse.quote(key)}"


def list_objects(prefix: str, timeout: int) -> Iterator[ObjectInfo]:
    """Yields all objects below `prefix`, following list pagination."""
    marker = ""
    while True:
        query = {"prefix": prefix}
        if marker:
            query["marker"] = marker
        url = f"{GCS_BASE_URL}?{urllib.parse.urlencode(query)}"
        with _open(url, timeout) as response:
            root = ET.fromstring(response.read())

        last_key = ""
        truncated = False
        next_marker = ""
        for child in root:
            tag = child.tag.rsplit("}", 1)[-1]
            if tag == "Contents":
                key = ""
                etag = ""
                for sub in child:
                    sub_tag = sub.tag.rsplit("}", 1)[-1]
                    if sub_tag == "Key":
                        key = sub.text or ""
                    elif sub_tag == "ETag":
                        etag = (sub.text or "").strip('"')
                if key:
                    last_key = key
                    yield ObjectInfo(key, etag)
            elif tag == "IsTruncated":
                truncated = (child.text or "").strip().lower() == "true"
            elif tag == "NextMarker":
                next_marker = child.text or ""

        if not truncated:
            return
        marker = next_marker or last_key
        if not marker:
            return


def resolve_stable_dir(
    component: Component, device: str, timeout: int
) -> Optional[str]:
    """Returns the bucket directory that holds the stable marker, if any."""
    marker_name = f"/stable.{device}.{component.marker_kind}"
    found = sorted(
        os.path.dirname(obj.key)
        for obj in list_objects(f"{component.prefix}/", timeout)
        if obj.key.endswith(marker_name)
    )
    if not found:
        return None
    if len(found) > 1:
        _warn(
            f"Several stable.{device}.{component.marker_kind} markers found"
            f" ({', '.join(found)}); using {found[0]}"
        )
    return found[0]


def pick_firmware_object(
    component: Component, version: str, objects: List[ObjectInfo]
) -> ObjectInfo:
    """Picks the firmware file of a marker directory deterministically.

    Each marker directory is expected to hold a single firmware file. If there
    are several, the first of component.preferred_names that exists wins,
    otherwise the alphabetically first file. A warning is printed either way.
    """
    if not objects:
        raise FetchError(f"no *{component.file_ext} file found")
    by_name: Dict[str, ObjectInfo] = {os.path.basename(obj.key): obj for obj in objects}
    names = sorted(by_name)
    if len(names) == 1:
        return by_name[names[0]]
    chosen = names[0]
    for preferred in component.preferred_names:
        name = preferred.format(version=version)
        if name in by_name:
            chosen = name
            break
    _warn(
        f"{component.name}: expected one *{component.file_ext} file in"
        f" {version}, found {len(names)} ({', '.join(names)}); using {chosen}"
    )
    return by_name[chosen]


def remote_md5(obj: ObjectInfo, timeout: int) -> Optional[str]:
    """Returns the hex MD5 of a bucket object, or None if it is unknown.

    The list ETag is the MD5 for regular uploads; for composite objects the
    MD5 (if any) is read from the x-goog-hash header.
    """
    etag = obj.etag.lower()
    if MD5_HEX_RE.match(etag):
        return etag
    with _open(_object_url(obj.key), timeout, method="HEAD") as response:
        for value in response.headers.get_all("x-goog-hash") or []:
            for part in value.split(","):
                algo, _, digest = part.strip().partition("=")
                if algo == "md5" and digest:
                    try:
                        return base64.b64decode(digest).hex()
                    except (binascii.Error, ValueError):
                        return None
    return None


def file_md5(path: str) -> str:
    h = hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(DOWNLOAD_CHUNK_BYTES), b""):
            h.update(chunk)
    return h.hexdigest()


def read_stable_info(comp_dir: str) -> Optional[Dict[str, str]]:
    try:
        with open(os.path.join(comp_dir, STABLE_INFO_FILE)) as f:
            info = json.load(f)
        return info if isinstance(info, dict) else None
    except (OSError, ValueError):
        return None


def is_up_to_date(comp_dir: str, version: str, md5: Optional[str]) -> bool:
    """Whether comp_dir already holds `version` with the given MD5."""
    if not md5:
        return False
    info = read_stable_info(comp_dir)
    if not info or info.get("version") != version or info.get("md5") != md5:
        return False
    file_name = info.get("file") or ""
    path = os.path.join(comp_dir, file_name)
    if os.path.basename(file_name) != file_name or not os.path.isfile(path):
        return False
    return file_md5(path) == md5


def download(url: str, out_path: str, timeout: int) -> str:
    """Downloads `url` to `out_path` and returns its hex MD5."""
    h = hashlib.md5()
    with _open(url, timeout) as response, open(out_path, "wb") as out:
        for chunk in iter(lambda: response.read(DOWNLOAD_CHUNK_BYTES), b""):
            h.update(chunk)
            out.write(chunk)
    os.chmod(out_path, 0o644)
    return h.hexdigest()


def remove_leftovers(dest: str, subdir: str) -> None:
    """Removes temporary directories left behind by interrupted runs."""
    for name in os.listdir(dest):
        if name.startswith(f".{subdir}.new.") or name.startswith(f".{subdir}.old."):
            shutil.rmtree(os.path.join(dest, name), ignore_errors=True)


def swap_in(new_dir: str, comp_dir: str) -> None:
    """Replaces comp_dir by new_dir, restoring comp_dir if that fails."""
    parent = os.path.dirname(comp_dir)
    old_dir = None
    if os.path.lexists(comp_dir):
        old_dir = tempfile.mkdtemp(
            prefix=f".{os.path.basename(comp_dir)}.old.", dir=parent
        )
        os.rmdir(old_dir)
        os.rename(comp_dir, old_dir)
    try:
        os.rename(new_dir, comp_dir)
    except BaseException:
        if old_dir:
            os.rename(old_dir, comp_dir)
        raise
    if old_dir:
        shutil.rmtree(old_dir, ignore_errors=True)


def fetch_component(
    component: Component,
    device: str,
    dest: str,
    force: bool,
    list_timeout: int,
    download_timeout: int,
    verbose: bool,
) -> None:
    """Resolves and installs one component. Raises FetchError on failure."""
    try:
        stable_dir = resolve_stable_dir(component, device, list_timeout)
        if not stable_dir:
            raise FetchError(
                f"'stable.{device}.{component.marker_kind}' marker not found"
                f" under {component.prefix}/"
            )
        version = os.path.basename(stable_dir)
        if verbose:
            _log(f"Resolved stable {component.name} firmware -> {stable_dir}")

        objects = [
            obj
            for obj in list_objects(f"{stable_dir}/", list_timeout)
            if os.path.dirname(obj.key) == stable_dir
            and obj.key.endswith(component.file_ext)
        ]
        try:
            obj = pick_firmware_object(component, version, objects)
        except FetchError as e:
            raise FetchError(f"{e} in {stable_dir}") from e
        file_name = os.path.basename(obj.key)
        expected_md5 = remote_md5(obj, list_timeout)

        os.makedirs(dest, exist_ok=True)
        comp_dir = os.path.join(dest, component.subdir)
        if not force and is_up_to_date(comp_dir, version, expected_md5):
            if verbose:
                _log(f"{component.name} firmware {version}/{file_name} is up to date.")
            return

        remove_leftovers(dest, component.subdir)
        new_dir = tempfile.mkdtemp(prefix=f".{component.subdir}.new.", dir=dest)
        try:
            url = _object_url(obj.key)
            if verbose:
                _log(f"Downloading {url}...")
            md5 = download(url, os.path.join(new_dir, file_name), download_timeout)
            if expected_md5 and md5 != expected_md5:
                raise FetchError(
                    f"MD5 mismatch for {obj.key}: expected {expected_md5}, got {md5}"
                )
            info = {
                "version": version,
                "file": file_name,
                "md5": md5,
                "source": f"gs://{BUCKET}/{obj.key}",
            }
            info_path = os.path.join(new_dir, STABLE_INFO_FILE)
            with open(info_path, "w") as f:
                json.dump(info, f, indent=2)
                f.write("\n")
            os.chmod(info_path, 0o644)
            os.chmod(new_dir, 0o755)
            swap_in(new_dir, comp_dir)
        except BaseException:
            shutil.rmtree(new_dir, ignore_errors=True)
            raise
        _log(f"Downloaded {component.name} firmware {version}: {file_name}")
    except FetchError:
        raise
    except Exception as e:  # pylint: disable=broad-except
        raise FetchError(str(e)) from e


def parse_args(argv: List[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--dest",
        required=True,
        help="Destination directory; files go to <dest>/mcu and <dest>/pdc",
    )
    parser.add_argument(
        "--device",
        default=DEFAULT_DEVICE,
        help=f"Device name used in the stable markers (default: {DEFAULT_DEVICE})",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Download even if STABLE.json shows the same version and MD5",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=DEFAULT_LIST_TIMEOUT_S,
        help="Timeout in seconds for bucket listing requests"
        f" (default: {DEFAULT_LIST_TIMEOUT_S})",
    )
    parser.add_argument(
        "--download-timeout",
        type=int,
        default=DEFAULT_DOWNLOAD_TIMEOUT_S,
        help="Timeout in seconds for firmware downloads"
        f" (default: {DEFAULT_DOWNLOAD_TIMEOUT_S})",
    )
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="Only report downloaded files and failures",
    )
    return parser.parse_args(argv)


def main(argv: List[str]) -> int:
    args = parse_args(argv)
    failed = False
    for component in COMPONENTS:
        try:
            fetch_component(
                component,
                args.device,
                args.dest,
                args.force,
                args.timeout,
                args.download_timeout,
                verbose=not args.quiet,
            )
        except FetchError as e:
            _warn(f"Could not fetch {component.name} firmware for {args.device}: {e}")
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
