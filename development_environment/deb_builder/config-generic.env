# DiagnoseMe Station Configuration of the editions without Maui (servo-dolos,
# and the unshipped dolos, servo-v4p1, servo-micro editions): online, always
# pull, watchtower, no browser start - the behaviour of the stations installed
# before the editions (which have no config.env and use the same defaults
# with the :release images).
#
# This file belongs to the package and is replaced on every upgrade. Put
# station specific settings (e.g. STATION_ID, RESULTS_SERVER) into
# /etc/diagnoseme/config.local.env instead: the package never ships or
# overwrites it, and it is read after this file, so its values win.
#
# DIAGNOSEME_EDITION, DOCKER_TAG, UI_URL and STATION_ID are filled in per
# edition by the deb and ISO builders (tools/edition_info.py render-config,
# see editions.json).

# DiagnoseMe edition installed on this station (informational; the edition is
# baked into the Docker images).
DIAGNOSEME_EDITION=

# Operation Mode: offline | online. Online mode pulls the images on every
# start and runs watchtower, which keeps them updated.
MODE=online

# Docker image tag to use (tools/promote.sh moves it together with :release).
DOCKER_TAG=

# Docker compose pull policy (online mode always pulls).
PULL_POLICY=always

# Automatically launch the web browser upon service start: true | false
AUTO_OPEN_BROWSER=false

# Web UI URL
UI_URL=

# Station ID (Optional)
STATION_ID=

# The upstream results server (RESULTS_SERVER) is not set here, so a value
# from the environment of start-diagnoseme keeps working; set it in
# config.local.env to make it permanent.
