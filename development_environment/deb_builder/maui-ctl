# Forward maui-ctl command to the running server container or local python script
if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^server$'; then
    docker exec -i server maui-ctl "$@"
elif [ -f /usr/local/maui/tools/src/maui_ctl.py ]; then
    python3 /usr/local/maui/tools/src/maui_ctl.py "$@"
else
    echo "Error: DiagnoseMe server container is not running. Please run 'start-diagnoseme' first."
    exit 1
fi
