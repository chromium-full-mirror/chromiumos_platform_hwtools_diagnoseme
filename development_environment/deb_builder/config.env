# DiagnoseMe Maui Station Configuration. Template of the Maui editions
# (editions.json "maui_utils": true); the other editions get
# config-generic.env.
#
# This file belongs to the package and is replaced on every upgrade. Put
# station specific settings (STATION_ID, RESULTS_SERVER, the MAUI_* test
# overrides below, ...) into /etc/diagnoseme/config.local.env instead: the
# package never ships or overwrites it, and it is read after this file, so
# its values win. The first upgrade from a package without
# config.local.env moves the station specific values of its config.env
# there (not on an edition switch).
#
# DIAGNOSEME_EDITION, DOCKER_TAG, UI_URL, STATION_ID, COMPOSE_FILE,
# FIRMWARE_COMPONENTS, MAUI_DEVICE, DIAGNOSEME_RESULTS_DIR, MAUI_H2H_FIRMWARE and
# MAUI_UTILS_IMAGE are filled in per edition by the deb and ISO builders
# (tools/edition_info.py render-config, see editions.json).

# DiagnoseMe edition installed on this station (informational; the edition is
# baked into the Docker images).
DIAGNOSEME_EDITION=

# Operation Mode: offline | online
MODE=offline

# Docker image tag to use (the edition id)
DOCKER_TAG=

# Docker compose files: the generic file plus the Maui override (Maui mounts
# and environment), separated by ':'.
COMPOSE_FILE=

# Docker compose pull policy in offline mode: if_not_present (use the
# pre-loaded offline images) | always. Online mode always pulls.
PULL_POLICY=if_not_present

# Download the latest stable Maui firmware in online mode: true | false
SYNC_MAUI_FIRMWARE=true

# Automatically launch Google Chrome upon service start: true | false
AUTO_OPEN_BROWSER=true

# Web UI URL
UI_URL=

# maui-utils image with the Maui flashing tools (Maui editions only).
# Filled in by the deb builder with the bundled stable release; when empty,
# the server uses the newest local maui-utils image.
MAUI_UTILS_IMAGE=

# Maui firmware components kept in /var/lib/diagnoseme/firmware/<component>;
# online mode fetches the stable versions of MAUI_DEVICE (the device part of
# the stable.<device>.* markers in gs://maui-firmware).
FIRMWARE_COMPONENTS=
MAUI_DEVICE=

# Maui results directory of the station (mounted 1:1 into the server).
DIAGNOSEME_RESULTS_DIR=

# Maui v1.2 H2H (PL27A1) firmware flashing on the programming page: true |
# false (editions.json "h2h_firmware"; true selects docker-compose-maui-h2h.yaml
# in COMPOSE_FILE). Only then start-diagnoseme creates the station directory
# of the H2H images, MAUI_H2H_FW_DIR (default: ~/diagnoseme_h2h_firmware of
# the desktop user), and mounts it read-only. The images are not part of
# DiagnoseMe: the operator copies the *.bin file there.
MAUI_H2H_FIRMWARE=
#MAUI_H2H_FW_DIR=/home/diagnoseme/diagnoseme_h2h_firmware

# Maui v1.2 only (optional overrides, set them in config.local.env): MCU App
# builds accepted by the functional tests and the H2H SPI check in addition
# to the bundled stable firmware (/var/lib/diagnoseme/firmware/mcu_{app,full}/
# STABLE.json, only when the image matches its md5), as comma separated
# "<major>.<count>-<hash>" ids, or "any" for every well-formed release build.
# Without both, the MCU Version Check fails (maui-v1.2 releases bundle the
# stable firmware) and the H2H SPI check does not run. A bundled STABLE.json
# that is invalid (image missing, md5 mismatch) always fails the check.
#MAUI_V12_APPROVED_FW=0.69-5324f43,0.67-17241ef
# Accepted `hwrev` values (default: 3).
#MAUI_V12_HWREVS=3
# Full MCU image flashing fails when itecomdbgr prints nothing for this many
# seconds (default: 40; the tool retries the debugger entry silently and only
# gives up after ~125 s).
#MAUI_ITE_NO_OUTPUT_TIMEOUT_S=40

# ADB data transfer test (optional overrides, set them in config.local.env):
# size of the first random file in MiB (default 400; the second file is 1-16
# MiB larger), limit in seconds of the transfer phase - push both, SHA-1 on
# the DUT, pull both (default 40; generating the files is not counted), the
# minimum push / pull rate in MB/s (default 0 = the speed is only logged),
# and the minimum USB link speed in Mbit/s of the H2H link on the host and
# the DUT (default 5000 = 5 Gbps). The defaults are the same for every Maui
# edition.
#MAUI_ADB_SIZE_MB=400
#MAUI_ADB_DEADLINE_S=40
#MAUI_ADB_MIN_RATE_MB_S=0
#MAUI_ADB_MIN_LINK_MBPS=5000

# Manufacturing Station ID (Optional)
STATION_ID=

# Upstream Manufacturing Execution System (MES) Webhook (Optional)
RESULTS_SERVER=
