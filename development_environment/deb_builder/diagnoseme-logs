COMPOSE_FILE="/etc/diagnoseme/docker-compose.yaml"

if [ "$1" == "--device" ] || [ "$1" == "-d" ]; then
    SERIAL="${2:-}"
    HOME_DIR="${HOME:-/home/diagnoseme}"
    if [ -n "$SERIAL" ]; then
        FOUND=false
        if [ -d "$HOME_DIR/diagnoseme_results" ]; then
            MATCHES=$(find "$HOME_DIR/diagnoseme_results" -name "*${SERIAL}*" 2>/dev/null)
            if [ -n "$MATCHES" ]; then
                echo "Final results in $HOME_DIR/diagnoseme_results:"
                echo "$MATCHES"
                FOUND=true
            fi
        fi
        if [ -d "/tmp/${SERIAL}_diagnoseme_logs" ]; then
            echo "Device logs in /tmp/${SERIAL}_diagnoseme_logs:"
            ls -la "/tmp/${SERIAL}_diagnoseme_logs"
            FOUND=true
        fi
        if [ "$FOUND" = false ]; then
            echo "No logs found for device serial '$SERIAL'."
        fi
    else
        echo "=================================================="
        echo " Available Device Log & Result Directories:"
        echo "=================================================="
        find "$HOME_DIR/diagnoseme_results" /tmp -maxdepth 2 -type d \( -name "*diagnoseme_logs" -o -name "highlevel" -o -name "detailed" \) 2>/dev/null | sort -u
    fi
    exit 0
fi

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Error: Docker compose file not found at $COMPOSE_FILE"
    exit 1
fi

SERVICE="${1:-}"
if [ -n "$SERVICE" ] && [ "$SERVICE" != "all" ]; then
    docker compose -f "$COMPOSE_FILE" logs -f "$SERVICE"
else
    docker compose -f "$COMPOSE_FILE" logs -f
fi
