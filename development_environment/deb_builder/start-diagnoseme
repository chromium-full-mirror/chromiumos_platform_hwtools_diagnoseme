set -e

CONFIG_DIR="${DIAGNOSEME_CONFIG_DIR:-/etc/diagnoseme}"
DEFAULT_COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yaml"
CONFIG_FILE="${CONFIG_DIR}/config.env"
# Station specific settings: never shipped or overwritten by the package and
# read after config.env, so its values win.
LOCAL_CONFIG_FILE="${CONFIG_DIR}/config.local.env"
DEFAULT_UI_URL="http://localhost:8888/"
FW_ROOT="/var/lib/diagnoseme/firmware"
MAUI_UTILS_DIR="${DIAGNOSEME_MAUI_UTILS_DIR:-/var/lib/diagnoseme/maui-utils}"
MAUI_UTILS_TAR="${MAUI_UTILS_DIR}/maui-utils.tar"
# {version, file, md5, source} of the bundled maui-utils.tar
# (tools/maui_fw_fetch.py, written when the package was built).
MAUI_UTILS_MANIFEST="${MAUI_UTILS_DIR}/STABLE.json"
MAUI_UTILS_STAGING="${MAUI_UTILS_DIR}/staging"

# Fetches the current Maui firmware of the edition from the public GCS bucket
# into ${FW_ROOT} (see tools/maui_fw_fetch.py, installed as
# fetch-maui-firmware). The download is skipped when the local STABLE.json
# already matches. Non-fatal: failures only print a warning and the firmware
# already on the station is used.
sync_maui_firmware() {
    local fetch_bin
    if ! fetch_bin="$(command -v fetch-maui-firmware)"; then
        echo "WARNING: fetch-maui-firmware is missing; skipping the Maui firmware sync."
        return 0
    fi
    local fetch=("$fetch_bin" --device "${MAUI_DEVICE}" --dest-root "${FW_ROOT}" \
        --timeout 5 --download-timeout 15 --retries 0 --quiet)
    if [ "$(id -u)" -ne 0 ] && [ ! -w "${FW_ROOT}" ]; then
        # The firmware directories belong to root (deb / ISO installation).
        fetch=(sudo -n "${fetch[@]}")
    fi
    echo "Checking for updated Maui firmware (${FIRMWARE_COMPONENTS}) from cloud..."
    # shellcheck disable=SC2086 # one argument per component
    if ! "${fetch[@]}" ${FIRMWARE_COMPONENTS}; then
        echo "WARNING: Maui firmware sync failed. Using cached offline firmware."
    fi
}

# Prints field $2 of the JSON object in file $1 (empty when missing).
json_field() {
    python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' \
        "$1" "$2" 2> /dev/null || true
}

# Checks the bundled maui-utils.tar against the md5 recorded in its
# STABLE.json before it is loaded (the image runs privileged). Fails closed:
# a missing or unreadable STABLE.json is an error too.
verify_maui_utils_tar() {
    local expected actual
    if [ ! -r "${MAUI_UTILS_MANIFEST}" ]; then
        echo "ERROR: ${MAUI_UTILS_MANIFEST} is missing; not loading ${MAUI_UTILS_TAR}."
        return 1
    fi
    expected="$(json_field "${MAUI_UTILS_MANIFEST}" md5)"
    if [[ ! "${expected}" =~ ^[0-9a-f]{32}$ ]]; then
        echo "ERROR: ${MAUI_UTILS_MANIFEST} has no valid md5; not loading ${MAUI_UTILS_TAR}."
        return 1
    fi
    echo "Verifying ${MAUI_UTILS_TAR} (md5 ${expected})..."
    actual="$(md5sum "${MAUI_UTILS_TAR}" | cut -d' ' -f1)"
    if [ "${actual}" != "${expected}" ]; then
        echo "ERROR: ${MAUI_UTILS_TAR} is damaged (md5 ${actual}, expected ${expected}); not loading it."
        return 1
    fi
}

# Sources config.env, then config.local.env (station overrides).
load_station_config() {
    local file
    for file in "$CONFIG_FILE" "$LOCAL_CONFIG_FILE"; do
        if [ -f "$file" ]; then
            # shellcheck disable=SC1090
            source "$file"
        fi
    done
}

# Prints the home directory of the desktop user, also when this runs as root
# (e.g. from diagnoseme-offline-update via sudo).
station_home() {
    local home="${HOME:-}"
    if [ "$(id -u)" -eq 0 ]; then
        if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
            home="$(getent passwd "${SUDO_USER}" | cut -d: -f6)"
        elif [ -d /home/diagnoseme ]; then
            home=/home/diagnoseme
        fi
    fi
    echo "${home:-/home/diagnoseme}"
}

# Creates the Maui v1.2 H2H firmware directory $1 before docker would (as
# root). The operator copies the H2H images there (the server only reads
# them), so a new directory belongs to the owner of its parent directory.
create_h2h_fw_dir() {
    local dir="$1" owner
    if [ -d "${dir}" ] || ! mkdir -p "${dir}" 2> /dev/null; then
        return 0
    fi
    if [ "$(id -u)" -eq 0 ]; then
        owner="$(stat -c %U:%G "$(dirname "${dir}")" 2> /dev/null || true)"
        if [ -n "${owner}" ]; then
            chown "${owner}" "${dir}" 2> /dev/null || true
        fi
    fi
}

# Unit tests source this script for its functions only.
if [ -n "${DIAGNOSEME_LIB_ONLY:-}" ]; then
    # shellcheck disable=SC2317 # exit only when executed, not sourced
    return 0 2> /dev/null || exit 0
fi

# Load configuration if available. Without a config.env (stations installed
# before the editions) the defaults below match the original
# start-diagnoseme: pull the :release images and run with watchtower. Every
# edition package ships a config.env naming its edition and image tag
# (editions.json); servo-dolos keeps the online defaults, the Maui editions
# select offline mode, firmware, maui-utils and the Maui compose override.
load_station_config

MODE="${MODE:-online}"
AUTO_OPEN_BROWSER="${AUTO_OPEN_BROWSER:-false}"
UI_URL="${UI_URL:-$DEFAULT_UI_URL}"
DOCKER_TAG="${DOCKER_TAG:-release}"
SYNC_MAUI_FIRMWARE="${SYNC_MAUI_FIRMWARE:-false}"
# Maui firmware components of the edition and the Maui device of their
# stable markers (editions.json "firmware" / "maui_device", written to the
# config.env of the Maui editions only). Only Maui stations have a
# MAUI_DEVICE; they alone create and mount the Maui directories.
FIRMWARE_COMPONENTS="${FIRMWARE_COMPONENTS:-}"
MAUI_DEVICE="${MAUI_DEVICE:-}"
MAUI_STATION=false
if [ -n "${MAUI_DEVICE}" ]; then
    MAUI_STATION=true
fi

# Parse command line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        --online)
            MODE="online"
            shift
            ;;
        --offline)
            MODE="offline"
            shift
            ;;
        --no-browser)
            AUTO_OPEN_BROWSER="false"
            shift
            ;;
        --tag)
            DOCKER_TAG="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: start-diagnoseme [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --online        Run in online mode (pulls latest Docker images, runs watchtower)"
            echo "  --offline       Run in offline mode (uses pre-loaded local images)"
            echo "                  Default mode: MODE from $CONFIG_FILE, else online"
            echo "  --no-browser    Start services without launching the web browser"
            echo "  --tag <tag>     Override Docker image tag (default: DOCKER_TAG from config, else release)"
            echo "  -h, --help      Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run 'start-diagnoseme --help' for usage."
            exit 1
            ;;
    esac
done

# Compose files: COMPOSE_FILE of config.env (the Maui editions add
# docker-compose-maui.yaml), separated by ':'.
IFS=':' read -r -a COMPOSE_FILES <<< "${COMPOSE_FILE:-$DEFAULT_COMPOSE_FILE}"
COMPOSE=(docker compose)
for F in "${COMPOSE_FILES[@]}"; do
    if [ ! -f "$F" ]; then
        echo "Error: Docker compose file not found at $F"
        exit 1
    fi
    COMPOSE+=(-f "$F")
done

echo "=================================================="
echo " Starting DiagnoseMe [Mode: ${MODE^^}]"
echo " Image Tag: ${DOCKER_TAG}"
echo "=================================================="

export DOCKER_TAG
export STATION_ID="${STATION_ID:-}"
export RESULTS_SERVER="${RESULTS_SERVER:-}"
if [ "$MAUI_STATION" = true ]; then
    # Maui results directory of the edition (config.env; required by
    # docker-compose-maui.yaml).
    export DIAGNOSEME_RESULTS_DIR="${DIAGNOSEME_RESULTS_DIR:-}"
    # Optional Maui test overrides (config.local.env; docker compose passes
    # them to the server only when they are exported).
    for VAR in MAUI_ADB_SIZE_MB MAUI_ADB_DEADLINE_S MAUI_ADB_MIN_RATE_MB_S MAUI_ADB_MIN_LINK_MBPS \
               MAUI_V12_APPROVED_FW MAUI_V12_HWREVS MAUI_ITE_NO_OUTPUT_TIMEOUT_S; do
        if [ -n "${!VAR:-}" ]; then
            export "${VAR?}"
        fi
    done
    if [ "${MAUI_H2H_FIRMWARE:-false}" = true ]; then
        # Station directory of the Maui v1.2 H2H firmware images (never
        # bundled: the operator copies them there);
        # docker-compose-maui-h2h.yaml mounts it read-only.
        MAUI_H2H_FW_DIR="${MAUI_H2H_FW_DIR:-$(station_home)/diagnoseme_h2h_firmware}"
        export MAUI_H2H_FW_DIR
    fi

    # The Maui flashing tools run in the maui-utils container. Load the
    # bundled image (md5 checked) if it is not present yet (offline stations).
    if [ -z "${MAUI_UTILS_IMAGE:-}" ] && [ -r "${MAUI_UTILS_MANIFEST}" ]; then
        MAUI_UTILS_VERSION="$(json_field "${MAUI_UTILS_MANIFEST}" version)"
        MAUI_UTILS_IMAGE="${MAUI_UTILS_VERSION:+maui-utils:${MAUI_UTILS_VERSION}}"
    fi
    if [ -f "${MAUI_UTILS_TAR}" ] && { [ -z "${MAUI_UTILS_IMAGE:-}" ] || \
            ! docker image inspect "${MAUI_UTILS_IMAGE}" > /dev/null 2>&1; }; then
        if verify_maui_utils_tar; then
            echo "Loading bundled ${MAUI_UTILS_IMAGE:-maui-utils} (this takes a minute)..."
            LOADED=$(docker load -i "${MAUI_UTILS_TAR}" | sed -n 's/^Loaded image[^:]*: //p' | tail -n 1)
            if [ -z "${MAUI_UTILS_IMAGE:-}" ]; then
                MAUI_UTILS_IMAGE="${LOADED}"
            elif [ -n "${LOADED}" ] && [ "${LOADED}" != "${MAUI_UTILS_IMAGE}" ]; then
                docker tag "${LOADED}" "${MAUI_UTILS_IMAGE}"
            fi
        fi
        if [ -z "${MAUI_UTILS_IMAGE:-}" ] || ! docker image inspect "${MAUI_UTILS_IMAGE}" > /dev/null 2>&1; then
            echo "ERROR: ${MAUI_UTILS_IMAGE:-maui-utils} is not available from ${MAUI_UTILS_TAR}."
            echo "       MCU / PDC flashing will fail. Reinstall the DiagnoseMe package or"
            echo "       apply an offline update bundle."
        fi
    elif [ -n "${MAUI_UTILS_IMAGE:-}" ] && ! docker image inspect "${MAUI_UTILS_IMAGE}" > /dev/null 2>&1; then
        echo "WARNING: ${MAUI_UTILS_IMAGE} is missing and no bundled image was found."
    fi
    if [ -n "${MAUI_UTILS_IMAGE:-}" ]; then
        export MAUI_UTILS_IMAGE
    fi
fi

# Ensure local image aliases exist for Docker Compose
for IMG in ui server envoy; do
    if docker image inspect "${IMG}:${DOCKER_TAG}" > /dev/null 2>&1 && ! docker image inspect "us-docker.pkg.dev/chromeos-hw-tools/diagnoseme/${IMG}:${DOCKER_TAG}" > /dev/null 2>&1; then
        docker tag "${IMG}:${DOCKER_TAG}" "us-docker.pkg.dev/chromeos-hw-tools/diagnoseme/${IMG}:${DOCKER_TAG}" 2>/dev/null || true
    fi
done

# Ensure the host log directories (and on Maui stations the firmware,
# staging, device log and results directories) exist. Ownership and
# permissions are set up once by the deb postinst.
HOST_DIRS=(/var/log/diagnoseme/nginx /var/log/diagnoseme/rpcserver /var/log/diagnoseme/envoy)
if [ "$MAUI_STATION" = true ]; then
    for COMP in ${FIRMWARE_COMPONENTS}; do
        HOST_DIRS+=("${FW_ROOT}/${COMP}")
    done
    HOST_DIRS+=("${MAUI_UTILS_STAGING}" /var/log/diagnoseme/devices)
    if [ -n "${DIAGNOSEME_RESULTS_DIR:-}" ]; then
        HOST_DIRS+=("${DIAGNOSEME_RESULTS_DIR}")
    fi
fi
mkdir -p "${HOST_DIRS[@]}" 2>/dev/null || true
if [ "$MAUI_STATION" = true ] && [ "${MAUI_H2H_FIRMWARE:-false}" = true ] && \
        [ -n "${MAUI_H2H_FW_DIR:-}" ]; then
    create_h2h_fw_dir "${MAUI_H2H_FW_DIR}"
fi

# Services started by 'up'. In offline mode watchtower is left out (Maui
# factory stations must not update themselves; its image is not in the
# offline bundle either). Naming the services keeps compose from pulling the
# watchtower image, which '--scale watchtower=0' would still do.
UP_SERVICES=()
if [ "$MODE" == "online" ]; then
    # Online mode always pulls the latest images, as before; the PULL_POLICY
    # from config.env only applies to offline mode.
    export PULL_POLICY="always"
    echo "Pulling updated Docker images (:tag ${DOCKER_TAG})..."
    "${COMPOSE[@]}" pull || {
        echo "WARNING: Online pull failed. Falling back to existing local images."
        export PULL_POLICY="if_not_present"
    }

    if [ "$MAUI_STATION" = true ] && [ "$SYNC_MAUI_FIRMWARE" = "true" ] && [ -n "${FIRMWARE_COMPONENTS}" ]; then
        sync_maui_firmware
    fi
else
    export PULL_POLICY="${PULL_POLICY:-if_not_present}"
    mapfile -t UP_SERVICES < <("${COMPOSE[@]}" config --services | grep -vx watchtower)
    if [ ${#UP_SERVICES[@]} -eq 0 ]; then
        UP_SERVICES=(ui server envoy)
    fi
fi

echo "Bringing up DiagnoseMe containers..."
"${COMPOSE[@]}" down --remove-orphans || true
"${COMPOSE[@]}" up -d "${UP_SERVICES[@]}"

# Returns success when the web UI answers. Uses curl if installed, else
# python3 (the diagnoseme package does not depend on curl).
ui_ready() {
    if command -v curl > /dev/null 2>&1; then
        curl -s -f "$UI_URL" > /dev/null 2>&1
    else
        python3 -c 'import sys, urllib.request; urllib.request.urlopen(sys.argv[1], timeout=5)' "$UI_URL" > /dev/null 2>&1
    fi
}

echo "Waiting for services to become ready..."
MAX_WAIT=30
WAITED=0
HEALTHY=false

while [ $WAITED -lt $MAX_WAIT ]; do
    if ui_ready; then
        HEALTHY=true
        break
    fi
    sleep 2
    WAITED=$((WAITED + 2))
    echo -n "."
done
echo ""

if [ "$HEALTHY" = true ]; then
    echo "DiagnoseMe services are healthy and running at $UI_URL."
else
    echo "DiagnoseMe services started, but web UI did not respond within ${MAX_WAIT}s."
    echo "Check logs with 'diagnoseme-logs'."
fi

if [ "$AUTO_OPEN_BROWSER" = "true" ]; then
    echo "Opening web interface in browser..."
    export DISPLAY="${DISPLAY:-:0}"

    # Determine desktop user and Xauthority for reliable graphical launch
    TARGET_USER="${SUDO_USER:-$USER}"
    if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
        if [ -d /home/diagnoseme ]; then
            TARGET_USER="diagnoseme"
        fi
    fi
    TARGET_HOME=$(getent passwd "$TARGET_USER" 2>/dev/null | cut -d: -f6 || echo "/home/$TARGET_USER")
    if [ -z "$XAUTHORITY" ] && [ -f "$TARGET_HOME/.Xauthority" ]; then
        export XAUTHORITY="$TARGET_HOME/.Xauthority"
    fi

    BROWSER_BIN=""
    for B in google-chrome google-chrome-stable chromium chromium-browser x-www-browser xdg-open firefox-esr firefox; do
        if command -v "$B" > /dev/null 2>&1; then
            BROWSER_BIN="$B"
            break
        fi
    done

    if [ -n "$BROWSER_BIN" ]; then
        CHROME_FLAGS=(--start-maximized --no-first-run --no-default-browser-check --disable-session-crashed-bubble)
        if [ "$(id -u)" -eq 0 ]; then
            if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
                sudo -u "$SUDO_USER" env DISPLAY="${DISPLAY:-:0}" XAUTHORITY="${XAUTHORITY:-$TARGET_HOME/.Xauthority}" nohup "$BROWSER_BIN" "${CHROME_FLAGS[@]}" "$UI_URL" > /dev/null 2>&1 &
            else
                nohup "$BROWSER_BIN" --no-sandbox "${CHROME_FLAGS[@]}" "$UI_URL" > /dev/null 2>&1 &
            fi
        else
            nohup "$BROWSER_BIN" "${CHROME_FLAGS[@]}" "$UI_URL" > /dev/null 2>&1 &
        fi
        disown 2>/dev/null || true
        echo "Launched $BROWSER_BIN at $UI_URL"
    else
        echo "Browser not found. Please navigate manually to $UI_URL"
    fi
fi

echo "=================================================="
echo " Done! Use 'stop-diagnoseme' to stop all services."
echo "=================================================="
