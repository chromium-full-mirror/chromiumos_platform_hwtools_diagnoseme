set -e

COMPOSE_FILE="/etc/diagnoseme/docker-compose.yaml"
CONFIG_FILE="/etc/diagnoseme/config.env"
DEFAULT_UI_URL="http://localhost:8888/"
FW_ROOT="/var/lib/diagnoseme/firmware"
FW_FETCH="/usr/lib/diagnoseme/maui_fw_fetch.py"

# Load configuration if available
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

MODE="${MODE:-offline}"
AUTO_OPEN_BROWSER="${AUTO_OPEN_BROWSER:-true}"
UI_URL="${UI_URL:-$DEFAULT_UI_URL}"
DOCKER_TAG="${DOCKER_TAG:-maui}"
# Maui firmware components of the edition (editions.json "firmware", written
# to config.env by the deb builder); fall back for config files without it.
if [ -z "${FIRMWARE_COMPONENTS:-}" ]; then
    case "${DIAGNOSEME_EDITION:-maui-v1.1}" in
        maui-v1.1|all) FIRMWARE_COMPONENTS="mcu pdc" ;;
        maui-v1.2) FIRMWARE_COMPONENTS="mcu_app mcu_full pdc" ;;
    esac
fi
FIRMWARE_COMPONENTS="${FIRMWARE_COMPONENTS:-}"
# Maui device of the stable firmware markers (editions.json "maui_device").
if [ -z "${MAUI_DEVICE:-}" ]; then
    case "${DIAGNOSEME_EDITION:-maui-v1.1}" in
        maui-v1.1|all) MAUI_DEVICE="maui_v11" ;;
        maui-v1.2) MAUI_DEVICE="maui_v12" ;;
    esac
fi
MAUI_DEVICE="${MAUI_DEVICE:-}"
# Home of the desktop user. The results live there, also when this runs as
# root (e.g. from diagnoseme-offline-update via sudo).
STATION_HOME="${HOME:-/home/diagnoseme}"
if [ "$(id -u)" -eq 0 ]; then
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        STATION_HOME=$(getent passwd "${SUDO_USER}" | cut -d: -f6)
    elif [ -d /home/diagnoseme ]; then
        STATION_HOME=/home/diagnoseme
    fi
fi
STATION_HOME="${STATION_HOME:-/home/diagnoseme}"
DIAGNOSEME_RESULTS_DIR="${STATION_HOME}/diagnoseme_results"

# Fetches the current Maui firmware of the edition from the public GCS bucket
# into ${FW_ROOT} (see maui_fw_fetch.py). Failures only print a warning.
sync_maui_firmware() {
    local fetch=(python3 "${FW_FETCH}" --device "${MAUI_DEVICE}" --dest-root "${FW_ROOT}" --timeout 10 --retries 0)
    if [ ! -f "${FW_FETCH}" ]; then
        echo "WARNING: ${FW_FETCH} is missing; skipping the Maui firmware sync."
        return 0
    fi
    if [ "$(id -u)" -ne 0 ] && [ ! -w "${FW_ROOT}" ]; then
        # The firmware directories belong to root (deb / ISO installation).
        fetch=(sudo -n "${fetch[@]}")
    fi
    echo "Checking for updated Maui firmware (${FIRMWARE_COMPONENTS}) from cloud..."
    # shellcheck disable=SC2086 # one argument per component
    if ! "${fetch[@]}" ${FIRMWARE_COMPONENTS}; then
        echo "WARNING: Maui firmware sync failed; using the firmware already on this station."
    fi
}

# Parse command line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        --online)
            MODE="online"
            shift
            ;;
        --offline)
            MODE="offline"
            shift
            ;;
        --no-browser)
            AUTO_OPEN_BROWSER="false"
            shift
            ;;
        --tag)
            DOCKER_TAG="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: start-diagnoseme [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --online        Run in online mode (pulls latest :${DOCKER_TAG} Docker images)"
            echo "  --offline       Run in offline mode (uses pre-loaded local images, default)"
            echo "  --no-browser    Start services without launching the web browser"
            echo "  --tag <tag>     Override Docker image tag (default: DOCKER_TAG of config.env)"
            echo "  -h, --help      Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run 'start-diagnoseme --help' for usage."
            exit 1
            ;;
    esac
done

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Error: Docker compose file not found at $COMPOSE_FILE"
    exit 1
fi

echo "=================================================="
echo " Starting DiagnoseMe [Mode: ${MODE^^}]"
echo " Image Tag: ${DOCKER_TAG}"
echo "=================================================="

export DOCKER_TAG="${DOCKER_TAG:-maui}"
export STATION_ID="${STATION_ID:-}"
export RESULTS_SERVER="${RESULTS_SERVER:-}"
export DIAGNOSEME_RESULTS_DIR
if [ -n "${MAUI_UTILS_IMAGE:-}" ]; then
    export MAUI_UTILS_IMAGE
fi
# Optional Maui test overrides of config.env (docker compose passes them to
# the server only when they are exported).
for VAR in MAUI_V12_APPROVED_FW MAUI_V12_HWREVS \
           MAUI_ITE_NO_OUTPUT_TIMEOUT_S \
           MAUI_ADB_SIZE_MB MAUI_ADB_DEADLINE_S MAUI_ADB_MIN_RATE_MB_S \
           MAUI_ADB_MIN_LINK_MBPS; do
    if [ -n "${!VAR:-}" ]; then
        export "${VAR?}"
    fi
done

# Maui editions run their flashing tools in the maui-utils container. Load the
# bundled image if it is not present yet (offline stations).
MAUI_UTILS_TAR="/var/lib/diagnoseme/maui-utils/maui-utils.tar"
if [ -f "${MAUI_UTILS_TAR}" ] && [ ! -r "${MAUI_UTILS_TAR}" ]; then
    # Older packages installed the tar readable by root only.
    sudo chmod 644 "${MAUI_UTILS_TAR}" || true
fi
if [ -z "${MAUI_UTILS_IMAGE:-}" ] && [ -r "${MAUI_UTILS_TAR}" ]; then
    # config.env of older packages has no MAUI_UTILS_IMAGE: use the
    # maui-utils:<version> tag stored in the bundled tar.
    MAUI_UTILS_IMAGE=$(python3 -c '
import json, sys, tarfile
with tarfile.open(sys.argv[1]) as tar:
    manifest = json.load(tar.extractfile("manifest.json"))
tags = [t for m in manifest for t in (m.get("RepoTags") or [])]
print(next((t for t in tags if t.startswith("maui-utils:")), ""))
' "${MAUI_UTILS_TAR}" 2>/dev/null || true)
fi
if [ -f "${MAUI_UTILS_TAR}" ] && { [ -z "${MAUI_UTILS_IMAGE:-}" ] || \
        ! docker image inspect "${MAUI_UTILS_IMAGE}" > /dev/null 2>&1; }; then
    echo "Loading bundled ${MAUI_UTILS_IMAGE:-maui-utils} (this takes a minute)..."
    LOADED=$(docker load -i "${MAUI_UTILS_TAR}" | sed -n 's/^Loaded image[^:]*: //p' | tail -n 1)
    if [ -z "${MAUI_UTILS_IMAGE:-}" ]; then
        MAUI_UTILS_IMAGE="${LOADED}"
    elif [ -n "${LOADED}" ] && [ "${LOADED}" != "${MAUI_UTILS_IMAGE}" ]; then
        docker tag "${LOADED}" "${MAUI_UTILS_IMAGE}"
    fi
    if [ -z "${MAUI_UTILS_IMAGE:-}" ] || ! docker image inspect "${MAUI_UTILS_IMAGE}" > /dev/null 2>&1; then
        echo "ERROR: could not load ${MAUI_UTILS_IMAGE:-maui-utils} from ${MAUI_UTILS_TAR}."
        echo "       MCU / PDC flashing will fail. Try:"
        echo "       sudo docker load -i ${MAUI_UTILS_TAR}"
    fi
elif [ -n "${MAUI_UTILS_IMAGE:-}" ] && ! docker image inspect "${MAUI_UTILS_IMAGE}" > /dev/null 2>&1; then
    echo "WARNING: ${MAUI_UTILS_IMAGE} is missing and no bundled image was found."
    # TODO(editions): fetch the stable maui-utils from GCS in online mode.
fi
if [ -n "${MAUI_UTILS_IMAGE:-}" ]; then
    export MAUI_UTILS_IMAGE
fi

# Ensure local image aliases exist for Docker Compose
for IMG in ui server envoy; do
    if docker image inspect "${IMG}:${DOCKER_TAG}" > /dev/null 2>&1 && ! docker image inspect "us-docker.pkg.dev/chromeos-hw-tools/diagnoseme/${IMG}:${DOCKER_TAG}" > /dev/null 2>&1; then
        docker tag "${IMG}:${DOCKER_TAG}" "us-docker.pkg.dev/chromeos-hw-tools/diagnoseme/${IMG}:${DOCKER_TAG}" 2>/dev/null || true
    fi
done

# Ensure host log, firmware and results directories exist with full permissions
FW_DIRS=()
for COMP in ${FIRMWARE_COMPONENTS}; do
    FW_DIRS+=("${FW_ROOT}/${COMP}")
done
mkdir -p /var/log/diagnoseme/nginx /var/log/diagnoseme/rpcserver /var/log/diagnoseme/envoy "${FW_DIRS[@]}" "${DIAGNOSEME_RESULTS_DIR}/highlevel" "${DIAGNOSEME_RESULTS_DIR}/detailed" 2>/dev/null || true
chmod -R 777 /var/log/diagnoseme "${HOME:-/home/diagnoseme}/diagnoseme_results" 2>/dev/null || true
if [ "$(id -u)" -eq 0 ] && [ "${STATION_HOME}" != "${HOME:-}" ]; then
    # Running as root for the desktop user: the results stay theirs.
    RESULTS_OWNER=$(stat -c %U:%G "${STATION_HOME}" 2>/dev/null || true)
    if [ -n "${RESULTS_OWNER}" ]; then
        chown -R "${RESULTS_OWNER}" "${DIAGNOSEME_RESULTS_DIR}" 2>/dev/null || true
    fi
fi

PROFILE_ARGS=""
if [ "$MODE" == "online" ]; then
    export PULL_POLICY="always"
    PROFILE_ARGS="--profile online"
    echo "Pulling updated Docker images (:tag ${DOCKER_TAG})..."
    docker compose -f "$COMPOSE_FILE" --profile online pull || {
        echo "WARNING: Online pull failed. Falling back to existing local images."
        export PULL_POLICY="if_not_present"
    }

    if [ -n "${FIRMWARE_COMPONENTS}" ]; then
        sync_maui_firmware
    fi
else
    export PULL_POLICY="if_not_present"
fi

echo "Bringing up DiagnoseMe containers..."
docker compose -f "$COMPOSE_FILE" down --remove-orphans || true
# shellcheck disable=SC2086
docker compose -f "$COMPOSE_FILE" $PROFILE_ARGS up -d

echo "Waiting for services to become ready..."
MAX_WAIT=30
WAITED=0
HEALTHY=false

while [ $WAITED -lt $MAX_WAIT ]; do
    if curl -s -f "$UI_URL" > /dev/null 2>&1; then
        HEALTHY=true
        break
    fi
    sleep 2
    WAITED=$((WAITED + 2))
    echo -n "."
done
echo ""

if [ "$HEALTHY" = true ]; then
    echo "DiagnoseMe services are healthy and running at $UI_URL."
else
    echo "DiagnoseMe services started, but web UI did not respond within ${MAX_WAIT}s."
    echo "Check logs with 'diagnoseme-logs'."
fi

if [ "$AUTO_OPEN_BROWSER" = "true" ]; then
    echo "Opening web interface in browser..."
    export DISPLAY="${DISPLAY:-:0}"

    # Determine desktop user and Xauthority for reliable graphical launch
    TARGET_USER="${SUDO_USER:-$USER}"
    if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
        if [ -d /home/diagnoseme ]; then
            TARGET_USER="diagnoseme"
        fi
    fi
    TARGET_HOME=$(getent passwd "$TARGET_USER" 2>/dev/null | cut -d: -f6 || echo "/home/$TARGET_USER")
    if [ -z "$XAUTHORITY" ] && [ -f "$TARGET_HOME/.Xauthority" ]; then
        export XAUTHORITY="$TARGET_HOME/.Xauthority"
    fi

    BROWSER_BIN=""
    for B in google-chrome google-chrome-stable chromium chromium-browser x-www-browser xdg-open firefox-esr firefox; do
        if command -v "$B" > /dev/null 2>&1; then
            BROWSER_BIN="$B"
            break
        fi
    done

    if [ -n "$BROWSER_BIN" ]; then
        CHROME_FLAGS=(--start-maximized --no-first-run --no-default-browser-check --disable-session-crashed-bubble)
        if [ "$(id -u)" -eq 0 ]; then
            if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
                sudo -u "$SUDO_USER" env DISPLAY="${DISPLAY:-:0}" XAUTHORITY="${XAUTHORITY:-$TARGET_HOME/.Xauthority}" nohup "$BROWSER_BIN" "${CHROME_FLAGS[@]}" "$UI_URL" > /dev/null 2>&1 &
            else
                nohup "$BROWSER_BIN" --no-sandbox "${CHROME_FLAGS[@]}" "$UI_URL" > /dev/null 2>&1 &
            fi
        else
            nohup "$BROWSER_BIN" "${CHROME_FLAGS[@]}" "$UI_URL" > /dev/null 2>&1 &
        fi
        disown 2>/dev/null || true
        echo "Launched $BROWSER_BIN at $UI_URL"
    else
        echo "Browser not found. Please navigate manually to $UI_URL"
    fi
fi

echo "=================================================="
echo " Done! Use 'stop-diagnoseme' to stop all services."
echo "=================================================="
