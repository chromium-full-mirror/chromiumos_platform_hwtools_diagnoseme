# Runs maui-flash / maui-ctl from the maui-utils container (the maui tools are
# not part of the DiagnoseMe images), or from a local Maui tools checkout if
# no maui-utils image is available. The deb installs this script as
# maui-flash and maui-ctl (symlink); the command run is selected by the name
# this script was invoked as.
#
# The current directory is mounted at /mnt/firmware_dir, so firmware files can
# be passed as /mnt/firmware_dir/<file>; the station firmware in
# /var/lib/diagnoseme/firmware is available read-only as well.

TOOL="$(basename "$0")"
case "$TOOL" in
    maui-flash) LOCAL_SCRIPT="/usr/local/maui/tools/src/maui_flash.py" ;;
    maui-ctl) LOCAL_SCRIPT="/usr/local/maui/tools/src/maui_ctl.py" ;;
    *)
        echo "Error: unsupported command name '$TOOL' (expected maui-flash or maui-ctl)." >&2
        exit 1
        ;;
esac

# config.env (package) and config.local.env (station overrides, read last).
for CONFIG_FILE in /etc/diagnoseme/config.env /etc/diagnoseme/config.local.env; do
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
    fi
done
if [ -z "${MAUI_UTILS_IMAGE:-}" ]; then
    # config.env of older packages: the newest local maui-utils image.
    MAUI_UTILS_IMAGE=$(docker images maui-utils \
        --format '{{.CreatedAt}}\t{{.Repository}}:{{.Tag}}' 2>/dev/null |
        grep -v ':<none>$' | sort -r | head -n 1 | cut -f2)
fi

if [ -z "${MAUI_UTILS_IMAGE}" ] || ! docker image inspect "$MAUI_UTILS_IMAGE" > /dev/null 2>&1; then
    if [ -f "$LOCAL_SCRIPT" ]; then
        exec python3 "$LOCAL_SCRIPT" "$@"
    fi
    echo "Error: Docker image '${MAUI_UTILS_IMAGE:-maui-utils}' not found. Run 'start-diagnoseme' first."
    exit 1
fi

TTY_ARGS=(-i)
if [ -t 0 ] && [ -t 1 ]; then
    TTY_ARGS=(-it)
fi

# Relative paths in the arguments refer to the current directory.
exec docker run --rm "${TTY_ARGS[@]}" --privileged \
    -v /dev:/dev -v /run/udev:/run/udev:ro \
    -v "$(pwd)":/mnt/firmware_dir -w /mnt/firmware_dir \
    -v /var/lib/diagnoseme/firmware:/var/lib/diagnoseme/firmware:ro \
    --entrypoint "$TOOL" "$MAUI_UTILS_IMAGE" "$@"
