set -e

COMPOSE_FILE="/etc/diagnoseme/docker-compose.yaml"

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Error: Docker compose file not found at $COMPOSE_FILE"
    exit 1
fi

echo "Stopping DiagnoseMe services..."
docker compose -f "$COMPOSE_FILE" down

echo "DiagnoseMe services stopped."
