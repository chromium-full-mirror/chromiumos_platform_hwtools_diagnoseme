set -e

CONFIG_DIR="${DIAGNOSEME_CONFIG_DIR:-/etc/diagnoseme}"
DEFAULT_COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yaml"
# config.env (package) and config.local.env (station overrides, read last).
for CONFIG in "${CONFIG_DIR}/config.env" "${CONFIG_DIR}/config.local.env"; do
    if [ -f "$CONFIG" ]; then
        # shellcheck disable=SC1090
        source "$CONFIG"
    fi
done

# docker-compose-maui.yaml (Maui stations) needs the results directory.
if [ -n "${DIAGNOSEME_RESULTS_DIR:-}" ]; then
    export DIAGNOSEME_RESULTS_DIR
fi
# Compose files of the station (config.env COMPOSE_FILE, ':' separated).
IFS=':' read -r -a COMPOSE_FILES <<< "${COMPOSE_FILE:-$DEFAULT_COMPOSE_FILE}"
COMPOSE=(docker compose)
for F in "${COMPOSE_FILES[@]}"; do
    if [ ! -f "$F" ]; then
        echo "Error: Docker compose file not found at $F"
        exit 1
    fi
    COMPOSE+=(-f "$F")
done

echo "Stopping DiagnoseMe services..."
"${COMPOSE[@]}" down

echo "DiagnoseMe services stopped."
