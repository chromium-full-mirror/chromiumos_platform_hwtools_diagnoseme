"""DiagnoseMe Maui Manufacturing Dashboard.

Reads high-level test results from ~/diagnoseme_results/highlevel/*.json
and computes real-time manufacturing statistics:
- Total units submitted
- Pass / Fail / Pass with Bypass counts
- Overall pass rate and first-pass yield percentage
- Stage-by-stage pass / fail / bypass breakdowns
- Recent device test submissions table
"""

import argparse
import glob
import json
import os
import shutil
import sys
import time
from typing import Any, Dict, List, Tuple

# ANSI color codes
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
CYAN = "\033[36m"
WHITE = "\033[37m"

STAGE_DISPLAY_NAMES = {
    "mcu_bsl_flashing": "1. MCU BSL Flashing",
    "ftdi_eeprom_programming": "2. FTDI EEPROM Programming",
    "pdc_fw_flashing": "3. PDC Firmware Flashing",
    "host_only_verification": "4. Host-Only Verification",
    "host_dut_verification": "5. Host-DUT Verification",
    "label_verified": "6. Barcode Label Verification",
}


def find_result_files() -> List[str]:
  """Searches for all highlevel result JSON files across standard directories."""
  search_dirs = [
      os.path.expanduser("~/diagnoseme_results/highlevel"),
      "/home/diagnoseme/diagnoseme_results/highlevel",
      "/root/diagnoseme_results/highlevel",
      "/tmp/diagnoseme_results/highlevel",
  ]
  seen_paths = set()
  result_files = []

  for d in search_dirs:
    if os.path.isdir(d):
      for path in glob.glob(os.path.join(d, "*.json")):
        real_path = os.path.realpath(path)
        if real_path not in seen_paths:
          seen_paths.add(real_path)
          result_files.append(real_path)

  return sorted(result_files)


def load_records(files: List[str]) -> List[Dict[str, Any]]:
  """Loads and deduplicates records by (serial_number, completion_time)."""
  records_by_key: Dict[Tuple[str, str], Dict[str, Any]] = {}

  for f in files:
    try:
      with open(f, "r", encoding="utf-8") as fp:
        data = json.load(fp)
      serial = data.get("serial_number") or os.path.basename(f).split("_")[0]
      comp_time = data.get("completion_time") or ""
      key = (str(serial), str(comp_time))

      # Store latest or richer record
      if key not in records_by_key or len(str(data)) > len(
          str(records_by_key[key])
      ):
        records_by_key[key] = data
    except Exception:
      # Skip corrupted or unreadable files gracefully
      continue

  # Sort by completion_time ascending
  return sorted(
      records_by_key.values(), key=lambda r: r.get("completion_time", "")
  )


def format_progress_bar(percentage: float, width: int = 20) -> str:
  """Generates an ASCII progress bar for yield percentage."""
  if percentage < 0:
    percentage = 0.0
  elif percentage > 100:
    percentage = 100.0
  filled_len = int(round(width * percentage / 100.0))
  empty_len = width - filled_len

  bar_color = GREEN if percentage >= 90 else (YELLOW if percentage >= 75 else RED)
  return f"{bar_color}[{'█' * filled_len}{'░' * empty_len}]{RESET}"


def render_dashboard(records: List[Dict[str, Any]], show_all: bool = False):
  """Renders the formatted CLI manufacturing dashboard."""
  term_width = shutil.get_terminal_size((80, 24)).columns
  width = min(term_width, 100)
  separator = "=" * width
  thin_sep = "-" * width

  # Header
  now_utc = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime())
  print(separator)
  print(f"{BOLD}{CYAN}{'MAUI MANUFACTURING PRODUCTION DASHBOARD':^{width}}{RESET}")
  print(separator)
  print(
      f"  Time: {BOLD}{now_utc}{RESET}  |  Storage: {DIM}~/diagnoseme_results/highlevel{RESET}"
  )
  print(thin_sep)

  if not records:
    print(f"\n{YELLOW}{BOLD}  No manufacturing results found yet.{RESET}")
    print("  Results will automatically appear here once units are saved in")
    print("  Maui Station 1-4 and exported to ~/diagnoseme_results/.\n")
    print(separator)
    return

  # Compute High-Level Metrics
  total_units = len(records)
  pass_count = sum(1 for r in records if r.get("overall_status") == "PASS")
  bypass_count = sum(
      1 for r in records if r.get("overall_status") == "PASS_WITH_BYPASS"
  )
  fail_count = sum(1 for r in records if r.get("overall_status") == "FAIL")
  total_passed = pass_count + bypass_count

  overall_yield = (total_passed / total_units * 100.0) if total_units > 0 else 0.0
  strict_yield = (pass_count / total_units * 100.0) if total_units > 0 else 0.0

  # KPI Summary Section
  yield_color = (
      GREEN if overall_yield >= 95 else (YELLOW if overall_yield >= 85 else RED)
  )

  print(f"{BOLD}{WHITE}SUMMARY KEY PERFORMANCE INDICATORS (KPIs):{RESET}")
  print(
      f"  • Total Units Tested:       {BOLD}{WHITE}{total_units:<6}{RESET} "
      f" Overall Pass Rate:  {BOLD}{yield_color}{overall_yield:>6.1f}%{RESET}  {format_progress_bar(overall_yield, 20)}"
  )
  print(
      f"  • Full Pass (No Bypass):    {BOLD}{GREEN}{pass_count:<6}{RESET} "
      f" ({strict_yield:5.1f}% First-Pass Yield)"
  )
  print(
      f"  • Passed with Bypass:       {BOLD}{YELLOW}{bypass_count:<6}{RESET} "
      f" ({(bypass_count/total_units*100):5.1f}%)"
  )
  print(
      f"  • Failed Units:             {BOLD}{RED}{fail_count:<6}{RESET} "
      f" ({(fail_count/total_units*100):5.1f}%)"
  )
  print(thin_sep)

  # Stage-by-Stage Breakdown
  print(f"{BOLD}{WHITE}STAGE-BY-STAGE PERFORMANCE BREAKDOWN:{RESET}")
  print(
      f"  {BOLD}{'Stage Name':<32} {'Tested':>8} {'Passed':>8} {'Failed':>8} {'Bypassed':>9} {'Stage Yield':>13}{RESET}"
  )
  print(f"  {'-'*32} {'-'*8} {'-'*8} {'-'*8} {'-'*9} {'-'*13}")

  stage_keys = [
      "mcu_bsl_flashing",
      "ftdi_eeprom_programming",
      "pdc_fw_flashing",
      "host_only_verification",
      "host_dut_verification",
      "label_verified",
  ]

  for key in stage_keys:
    stage_name = STAGE_DISPLAY_NAMES.get(key, key)
    s_tested = 0
    s_passed = 0
    s_failed = 0
    s_bypassed = 0

    for r in records:
      stages = r.get("stage_statuses", {})
      status = stages.get(key)
      if status:
        s_tested += 1
        if status == "PASSED":
          s_passed += 1
        elif status == "FAILED":
          s_failed += 1
        elif "BYPASS" in status:
          s_bypassed += 1

    if s_tested > 0:
      s_yield = (s_passed + s_bypassed) / s_tested * 100.0
      y_col = GREEN if s_yield >= 95 else (YELLOW if s_yield >= 85 else RED)
      print(
          f"  {stage_name:<32} {s_tested:>8} {GREEN}{s_passed:>8}{RESET} {RED}{s_failed:>8}{RESET} {YELLOW}{s_bypassed:>9}{RESET} {BOLD}{y_col}{s_yield:>12.1f}%{RESET}"
      )
    else:
      print(
          f"  {stage_name:<32} {DIM}{'0':>8} {'-':>8} {'-':>8} {'-':>9} {'N/A':>13}{RESET}"
      )

  print(thin_sep)

  # Recent Submissions Table
  display_records = records if show_all else records[-10:]
  print(
      f"{BOLD}{WHITE}RECENT DEVICE SUBMISSIONS (Last {len(display_records)} of {total_units}):{RESET}"
  )
  print(
      f"  {BOLD}{'Timestamp (UTC)':<19} {'Serial Number':<18} {'Operator':<12} {'Verdict':<16} {'Notes / Stage Failures'}{RESET}"
  )
  print(f"  {'-'*19} {'-'*18} {'-'*12} {'-'*16} {'-'*24}")

  for r in reversed(display_records):
    ts = (r.get("completion_time") or "").replace("T", " ").replace("Z", "")[:19]
    serial = r.get("serial_number") or "UNKNOWN"
    operator = r.get("operator_id") or "OP_FACTORY"
    status = r.get("overall_status") or "UNKNOWN"

    if status == "PASS":
      status_str = f"{GREEN}{BOLD}PASS{RESET}"
    elif status == "PASS_WITH_BYPASS":
      status_str = f"{YELLOW}{BOLD}PASS (BYPASS){RESET}"
    elif status == "FAIL":
      status_str = f"{RED}{BOLD}FAIL{RESET}"
    else:
      status_str = f"{WHITE}{status}{RESET}"

    # Identify failed or bypassed stages
    stages = r.get("stage_statuses", {})
    failed_stages = [k for k, v in stages.items() if v == "FAILED"]
    bypassed_stages = [k for k, v in stages.items() if "BYPASS" in v]

    notes = []
    if failed_stages:
      notes.append(f"Failed: {', '.join(failed_stages)}")
    if bypassed_stages:
      notes.append(f"Bypassed: {', '.join(bypassed_stages)}")
    notes_str = " | ".join(notes) if notes else "All stages OK"

    print(
        f"  {ts:<19} {CYAN}{serial:<18}{RESET} {operator:<12} {status_str:<25} {DIM}{notes_str}{RESET}"
    )

  print(separator)
  print(
      f"  {DIM}Commands: 'diagnoseme-logs <SERIAL>' for detailed logs | 'diagnoseme-dashboard --watch' for live refresh{RESET}"
  )
  print(separator)


def main():
  parser = argparse.ArgumentParser(
      description="DiagnoseMe Maui Manufacturing Dashboard"
  )
  parser.add_argument(
      "-w",
      "--watch",
      action="store_true",
      help="Continuously refresh the dashboard every 3 seconds",
  )
  parser.add_argument(
      "-i",
      "--interval",
      type=int,
      default=3,
      help="Refresh interval in seconds when using --watch (default: 3)",
  )
  parser.add_argument(
      "-a",
      "--all",
      action="store_true",
      help="Display all submitted devices in history table (not just last 10)",
  )
  parser.add_argument(
      "-j",
      "--json",
      action="store_true",
      help="Output summary metrics as JSON instead of formatted text",
  )

  args = parser.parse_args()

  def run_once():
    files = find_result_files()
    records = load_records(files)

    if args.json:
      total = len(records)
      pass_count = sum(1 for r in records if r.get("overall_status") == "PASS")
      bypass_count = sum(
          1 for r in records if r.get("overall_status") == "PASS_WITH_BYPASS"
      )
      fail_count = sum(1 for r in records if r.get("overall_status") == "FAIL")
      payload = {
          "total_units": total,
          "passed": pass_count,
          "passed_with_bypass": bypass_count,
          "failed": fail_count,
          "overall_yield_pct": (
              ((pass_count + bypass_count) / total * 100.0) if total else 0.0
          ),
          "records_count": len(records),
      }
      print(json.dumps(payload, indent=2))
    else:
      render_dashboard(records, show_all=args.all)

  if args.watch:
    try:
      while True:
        os.system("clear")
        run_once()
        print(f"\n  {DIM}Auto-refreshing every {args.interval}s. Press Ctrl+C to exit.{RESET}")
        time.sleep(args.interval)
    except KeyboardInterrupt:
      print(f"\n{GREEN}Exited dashboard.{RESET}")
      sys.exit(0)
  else:
    run_once()


if __name__ == "__main__":
  main()
