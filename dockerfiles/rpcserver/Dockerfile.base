#
# Multi-target base image of the DiagnoseMe rpcserver.
#
# Every DiagnoseMe edition (see editions.json) has its own final target that
# only contains the tooling the edition needs:
#
#   base-servo-dolos  Servo / Dolos: every Servo and Dolos tool (the server
#                     image of the stations installed before the editions)
#   base-dolos        Dolos rework (doloscmd, dolosbattery, fw-updater)
#   base-servo-v4p1   Servo v4p1 (dfu-util, dfu-programmer, fwupd 2.0.19 built
#                     from source as on main, rtunicpg, ...)
#   base-servo-micro  Servo Micro (dfu-util, servo_micro firmware)
#   base-maui-v1.1    Maui v1.1 (adb, ft232r_prog; flashing via maui-utils)
#   base-maui-v1.2    Maui v1.2 (adb, itecomdbgr; App/PDC flashing via maui-utils)
#   base-all          Every tool above (development / CQ only)
#
# Always name the target of the edition (src/server/tests/unit/test_editions.py
# checks that every edition of editions.json has one), e.g.:
#   docker build --target base-maui-v1.1 -f dockerfiles/rpcserver/Dockerfile.base .
#
# The Maui flashing tools (maui-flash, maui-ctl, fw-updater) are NOT part of
# the Maui images. They run inside the separate maui-utils container, started by the
# server through the host docker socket (see src/server/maui_utils_runner.py).
# The one exception is itecomdbgr (ChromiumOS platform/ec): it writes the whole
# Maui v1.2 MCU flash over an external USB-UART bridge and lives in the server
# image (see src/server/maui_v12_ite_flash.py).

####################################################################
FROM debian:trixie AS hdctools-builder

RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    git \
    ca-certificates

WORKDIR /
RUN git clone --filter=blob:none --no-checkout --depth 1 --sparse https://chromium.googlesource.com/chromiumos/third_party/hdctools
WORKDIR /hdctools
RUN git sparse-checkout init --cone
RUN git sparse-checkout set servo/firmware/usbkm/KeyboardSerial/
RUN git checkout

######################################################################
FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:alpine AS rtk-fetcher
WORKDIR /fetch
# Copy files from dist if they exist (as on main before the editions). Kaniko
# and Docker will not fail if the files are missing because of the wildcard;
# they are then downloaded, and the build fails if that is not possible.
COPY dist/rtunicpg.tar.bz2* dist/r8152-2.21.4.tar.bz2* ./
RUN if [ ! -f rtunicpg.tar.bz2 ]; then \
        gcloud storage cp "gs://rtk-tools/rtunicpg-2.0.25.3.tar.bz2" rtunicpg.tar.bz2; \
    fi && \
    if [ ! -f r8152-2.21.4.tar.bz2 ]; then \
        gcloud storage cp gs://rtk-tools/r8152-2.21.4.tar.bz2 .; \
    fi

####################################################################
FROM python:3-trixie AS dolostools

RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    git \
    apt-transport-https

WORKDIR /
# TODO: pin dolos to a commit for reproducible builds
RUN git clone https://chromium.googlesource.com/chromiumos/platform/dolos
RUN python3 -m pip install -r /dolos/tools/requirements.txt --require-hashes --break-system-packages

WORKDIR /dolos/tools/doloscmd
RUN python3 setup.py bdist_wheel

WORKDIR /dolos/tools/dolosbattery
RUN python3 setup.py bdist_wheel

####################################################################
# Dolos fw-updater (Dolos edition tooling).
FROM debian:trixie AS fwupdater-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    git \
    libudev-dev \
    pkg-config \
    ca-certificates

# TODO: pin rustup/the rust toolchain to a version/checksum for reproducible builds
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /
# TODO: pin dolos to a commit for reproducible builds
RUN git clone https://chromium.googlesource.com/chromiumos/platform/dolos
WORKDIR /dolos/fw-updater
ENV USER=root
RUN cargo build --release

######################################################################
# fwupd 2.0.19 built from source (standalone, no systemd / polkit), exactly
# as on main before the editions: fwupdtool updates the Servo v4p1 GL3590 hub
# (genesys_hub_programmer.py). Used by base-servo-v4p1 and the images based
# on it (base-servo-dolos, base-all).
FROM debian:trixie AS fwupd-builder

RUN apt update
RUN apt install -y xz-utils wget build-essential dh-make devscripts
RUN wget https://github.com/fwupd/fwupd/releases/download/2.0.19/fwupd-2.0.19.tar.xz
RUN tar xvf fwupd-2.0.19.tar.xz

WORKDIR fwupd-2.0.19

RUN python3 ./contrib/ci/fwupd_setup_helpers.py install-dependencies -y --os debian -y
ENV DEBEMAIL="your-email@example.com"
ENV DEBFULLNAME="Your Name"
ENV DEB_BUILD_OPTIONS=nostrip=no

RUN dh_make -s -n -f "../fwupd-2.0.19.tar.xz" -y

RUN printf "\n\noverride_dh_auto_configure:\n\tdh_auto_configure -- \
    -Dauto_features=enabled \
    -Dbluez=disabled \
    -Dcbor=disabled \
    -Ddocs=disabled \
    -Dintrospection=disabled \
    -Dlibarchive=disabled \
    -Dlibdrm=disabled \
    -Dlibmnl=disabled \
    -Dpassim=disabled \
    -Dplugin_flashrom=disabled \
    -Dplugin_modem_manager=disabled \
    -Dpolkit=disabled \
    -Dprotobuf=disabled \
    -Dsystemd=disabled \
    -Dtests=false \
    -Dumockdev_tests=disabled \
    -Dvalgrind=disabled \
    -Dvalgrind=disabled \
    -Dbash_completion=false \
    -Dblkid=disabled \
    -Dbuild=standalone \
    -Dfirmware-packager=false \
    -Dfish_completion=false \
    -Dgnutls=disabled \
    -Dhsi=disabled \
    -Dlvfs=disabled \
    -Dman=false \
    -Dqubes=false \
    -Dreadline=disabled \
    -Dplugin_uefi_capsule_splash=false" >> debian/rules

RUN printf "\noverride_dh_shlibdeps:\n\t-dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info\n" >> debian/rules

RUN debuild -b -j$(nproc) -us -uc

######################################################################
FROM debian:trixie AS rtk-tools-builder

RUN apt-get update && apt-get install -y bzip2
WORKDIR /build
COPY --from=rtk-fetcher /fetch/rtunicpg.tar.bz2 .
RUN tar -xvf rtunicpg.tar.bz2

######################################################################
FROM debian:trixie AS ft232r-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libftdi-dev \
    libusb-dev \
    build-essential \
    curl \
    ca-certificates

WORKDIR /build
# TODO: pin ft232r_prog to a checksum (and verify TLS) for reproducible builds
RUN curl -k -sSL https://rtr.ca/ft232r/ft232r_prog-1.25.tar.gz | tar -xz \
 && make -C ft232r_prog-1.25

######################################################################
# itecomdbgr: ITE IT8xxx2 UART DBGR flasher (whole Maui v1.2 MCU image).
# Same build as the ec-devutils ebuild, without cros_sdk: only the three
# source files and LICENSE are fetched from chromiumos/platform/ec at a pinned
# commit and checked against their sha256. Bump EC_COMMIT and the hashes
# together, deliberately.
FROM debian:trixie AS itecomdbgr-builder

ARG EC_REPO=https://chromium.googlesource.com/chromiumos/platform/ec
ARG EC_COMMIT=7b199d4f080e2d35cec41a71a206dfb813c0c616

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    g++

WORKDIR /src
RUN set -e; \
    for f in util/itecomdbgr.cc util/uart_utils.cc util/uart_utils.h LICENSE; do \
      curl -fsSL --retry 5 --retry-all-errors \
        "${EC_REPO}/+/${EC_COMMIT}/${f}?format=TEXT" \
        | base64 -d > "$(basename "${f}")"; \
    done; \
    printf '%s\n' \
      'ef9ec892df5e75ef3791b43f32bdbf13276f539bd009a7c2a88f16d9ca82522c  itecomdbgr.cc' \
      '1477835d815156edd2ffacc3f02236521cb47fd1eab6bd07c2b169ac85497db0  uart_utils.cc' \
      'f00c86d8390eda6e749d388741ae22fc3a10e5da61ab74dbb59c4e6c902fed57  uart_utils.h' \
      'f0edee4e8678401849119448fc7412a0ce153710298013f1d47b41b2993f4336  LICENSE' \
      | sha256sum -c -
RUN mkdir -p /out \
 && g++ -O2 -Wall -s -o /out/itecomdbgr itecomdbgr.cc uart_utils.cc -I. \
 && cp LICENSE /out/LICENSE \
 && echo "${EC_REPO} ${EC_COMMIT} util/itecomdbgr.cc util/uart_utils.cc" > /out/SOURCE

######################################################################
FROM debian:trixie AS servo-fw-fetcher

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    ca-certificates

RUN mkdir -p /out/genesys /out/servo_v4p1 /out/servo_micro
RUN wget https://storage.googleapis.com/fwupd-cache/GenesysLogic_Google_Servo_GL3590_64.18.cab \
    -O /out/genesys/GenesysLogic_GL3590_64.18.cab
WORKDIR /out/servo_v4p1
RUN wget https://storage.googleapis.com/chromeos-localmirror/distfiles/servo_v4p1_v2.0.29298-4d4a4e980.tar.xz \
    -O servo_v4p1.tar.xz && tar xvf servo_v4p1.tar.xz && rm servo_v4p1.tar.xz
WORKDIR /out/servo_micro
RUN wget https://storage.googleapis.com/chromeos-localmirror/distfiles/servo_micro_v2.4.82-dbed085877.tar.xz \
    -O servo_micro.tar.xz && tar xvf servo_micro.tar.xz && rm servo_micro.tar.xz

#####################################################################
# Common runtime shared by every edition.
FROM python:3-trixie AS base-common

RUN apt-get update && apt-get install -yq \
    python3-docker \
    usb.ids \
    usbutils \
    libusb-1.0-0 \
    libudev1 \
    udev \
    libudev-dev

COPY dockerfiles/rpcserver/requirements.txt .
RUN python3 -m pip install -r requirements.txt --require-hashes --break-system-packages && \
    apt-get remove -y python3-protobuf || true

RUN mkdir /var/log/rpcserver
RUN mkdir /usr/local/tmp
RUN mkdir -p /usr/local/server/binfiles
RUN mkdir -p /usr/local/server/binfiles_shadow
RUN chmod og+w /var/log

ENV PYTHONPATH=/usr/lib/python3/dist-packages/

WORKDIR /usr/local/server
EXPOSE 6002

#####################################################################
FROM base-common AS base-dolos

COPY --from=fwupdater-builder /dolos/fw-updater/target/release/fw-updater /usr/local/bin/fw-updater

WORKDIR /install_tmp
COPY --from=dolostools /dolos/tools/doloscmd/dist .
COPY --from=dolostools /dolos/tools/dolosbattery/dist .
COPY --from=dolostools /dolos/tools/requirements.txt .
# PYTHONPATH (set in base-common) exposes debian dist-packages, which pip
# cannot uninstall; keep it unset while installing (as before editions).
RUN PYTHONPATH= python3 -m pip install *.whl --no-deps --no-index --break-system-packages
RUN PYTHONPATH= python3 -m pip install -r requirements.txt --require-hashes --break-system-packages
WORKDIR /usr/local/server
RUN rm -rf /install_tmp

#####################################################################
# Tooling shared by both servo editions (servod runs in its own container).
FROM base-common AS base-servo-common

RUN apt-get update && apt-get install -yq \
    dfu-util

#####################################################################
FROM base-servo-common AS base-servo-v4p1

RUN apt-get update && apt-get install -yq \
    dfu-programmer \
    libcurl3t64-gnutls \
    libxmlb2 \
    libjcat1 \
    ethtool

# fwupd 2.0.19 from fwupd-builder (not Debian's fwupd), as on main.
WORKDIR /install_tmp
COPY --link --from=fwupd-builder /fwupd_*_amd64.deb .
RUN apt install -y ./fwupd_*_amd64.deb
WORKDIR /usr/local/server
RUN rm -rf /install_tmp

COPY --from=rtk-tools-builder /build/*/rtunicpg-x86_64 /usr/local/bin/rtunicpg
COPY --from=rtk-tools-builder /build/*/EF8153B* /usr/local/server/binfiles_shadow/
COPY --from=rtk-tools-builder /build/*/EE8153B* /usr/local/server/binfiles_shadow/
COPY --from=hdctools-builder /hdctools/servo/firmware/usbkm/KeyboardSerial/Keyboard.hex /usr/local/server/binfiles_shadow/
COPY --from=servo-fw-fetcher /out/genesys/ /usr/local/genesys/
COPY --from=servo-fw-fetcher /out/servo_v4p1/ /usr/local/servo_v4p1/

#####################################################################
FROM base-servo-common AS base-servo-micro

COPY --from=servo-fw-fetcher /out/servo_micro/ /usr/local/servo_micro/

#####################################################################
# Tooling shared by every Maui revision. The flashing tools live in the
# maui-utils container, so only host-side discovery helpers are needed here.
FROM base-common AS base-maui-common

RUN apt-get update && apt-get install -yq \
    adb

# Docker CLI used to start maui-utils through the host docker socket.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

#####################################################################
# Maui v1.1: TI MSPM0 behind an FTDI FT232R bridge.
FROM base-maui-common AS base-maui-v1.1

RUN apt-get update && apt-get install -yq \
    libftdi1-2 \
    libftdi1

COPY --from=ft232r-builder /build/ft232r_prog-1.25/ft232r_prog /usr/local/bin/ft232r_prog

#####################################################################
# Maui v1.2: ITE IT82002 with native USB CDC-ACM console.
FROM base-maui-common AS base-maui-v1.2

# Whole-image MCU flashing over an external USB-UART bridge (UART DBGR).
COPY --from=itecomdbgr-builder /out/itecomdbgr /usr/local/bin/itecomdbgr
COPY --from=itecomdbgr-builder /out/LICENSE /out/SOURCE /usr/share/doc/itecomdbgr/

#####################################################################
# Servo / Dolos: the Servo v4p1, Servo Micro and Dolos tooling in one image
# (the content of the single server image before the editions).
FROM base-servo-v4p1 AS base-servo-dolos

COPY --from=servo-fw-fetcher /out/servo_micro/ /usr/local/servo_micro/
COPY --from=fwupdater-builder /dolos/fw-updater/target/release/fw-updater /usr/local/bin/fw-updater

WORKDIR /install_tmp
COPY --from=dolostools /dolos/tools/doloscmd/dist .
COPY --from=dolostools /dolos/tools/dolosbattery/dist .
COPY --from=dolostools /dolos/tools/requirements.txt .
# PYTHONPATH (set in base-common) exposes debian dist-packages, which pip
# cannot uninstall; keep it unset while installing (as before editions).
RUN PYTHONPATH= python3 -m pip install *.whl --no-deps --no-index --break-system-packages
RUN PYTHONPATH= python3 -m pip install -r requirements.txt --require-hashes --break-system-packages
WORKDIR /usr/local/server
RUN rm -rf /install_tmp

#####################################################################
# Development / CQ image containing the tooling of every edition.
FROM base-servo-dolos AS base-all

RUN apt-get update && apt-get install -yq \
    adb \
    libftdi1-2 \
    libftdi1

COPY --from=ft232r-builder /build/ft232r_prog-1.25/ft232r_prog /usr/local/bin/ft232r_prog
COPY --from=itecomdbgr-builder /out/itecomdbgr /usr/local/bin/itecomdbgr
COPY --from=itecomdbgr-builder /out/LICENSE /out/SOURCE /usr/share/doc/itecomdbgr/
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
