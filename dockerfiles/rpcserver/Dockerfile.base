####################################################################
FROM debian:trixie AS hdctools-builder

RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    git \
    ca-certificates

WORKDIR /
RUN git clone --filter=blob:none --no-checkout --depth 1 --sparse https://chromium.googlesource.com/chromiumos/third_party/hdctools
WORKDIR /hdctools
RUN git sparse-checkout init --cone
RUN git sparse-checkout set servo/firmware/usbkm/KeyboardSerial/
RUN git checkout

######################################################################
FROM debian:trixie AS rtk-fetcher
WORKDIR /fetch
# Optional dist copy; wildcard keeps Docker from failing if absent
COPY dist/rtunicpg.tar.bz2* dist/r8152-2.21.4.tar.bz2* ./

####################################################################
FROM python:3-trixie AS dolostools

RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    git \
    apt-transport-https

WORKDIR /
RUN git clone https://chromium.googlesource.com/chromiumos/platform/dolos
RUN python3 -m pip install -r /dolos/tools/requirements.txt --require-hashes --break-system-packages

WORKDIR /dolos/tools/doloscmd
RUN python3 setup.py bdist_wheel

WORKDIR /dolos/tools/dolosbattery
RUN python3 setup.py bdist_wheel

WORKDIR /
RUN git clone https://chromium.googlesource.com/chromiumos/platform/hwtools/maui /maui || true

####################################################################
FROM debian:trixie AS fwupdater-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    git \
    libudev-dev \
    pkg-config \
    ca-certificates

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /
RUN git clone https://chromium.googlesource.com/chromiumos/platform/dolos
WORKDIR /dolos/fw-updater
ENV USER=root
RUN cargo build --release


######################################################################
FROM debian:trixie AS rtk-tools-builder

RUN apt-get update && apt-get install -y bzip2
WORKDIR /build
COPY --from=rtk-fetcher /fetch/rtunicpg.tar.bz2* ./
RUN if [ -s rtunicpg.tar.bz2 ]; then \
        tar -xvf rtunicpg.tar.bz2 || true; \
    fi && \
    mkdir -p /build/stub && \
    touch /build/stub/rtunicpg-x86_64 /build/stub/EF8153B_stub /build/stub/EE8153B_stub

######################################################################
FROM debian:trixie AS ft232r-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libftdi-dev \
    libusb-dev \
    build-essential \
    curl \
    ca-certificates

WORKDIR /build
RUN curl -k -sSL https://rtr.ca/ft232r/ft232r_prog-1.25.tar.gz | tar -xz \
 && make -C ft232r_prog-1.25

#####################################################################
FROM python:3-trixie

RUN apt-get update && apt-get install -yq \
    python3-docker \
    dfu-util \
    dfu-programmer \
    usb.ids \
    libcurl3t64-gnutls \
    libxmlb2 \
    libjcat1 \
    ethtool \
    usbutils \
    adb \
    libftdi1-2 \
    libftdi1 \
    libusb-1.0-0 \
    libudev1 \
    udev \
    libudev-dev \
    fwupd

COPY dockerfiles/rpcserver/requirements.txt .
RUN python3 -m pip install -r requirements.txt --require-hashes --break-system-packages && \
    apt-get remove -y python3-protobuf || true

RUN mkdir /var/log/rpcserver
RUN mkdir /usr/local/tmp
RUN mkdir -p /usr/local/server/binfiles
RUN mkdir -p /usr/local/server/binfiles_shadow

COPY --from=rtk-tools-builder /build/*/rtunicpg-x86_64 /usr/local/bin/rtunicpg
COPY --from=rtk-tools-builder /build/*/EF8153B* /usr/local/server/binfiles_shadow/
COPY --from=rtk-tools-builder /build/*/EE8153B* /usr/local/server/binfiles_shadow/
COPY --from=ft232r-builder /build/ft232r_prog-1.25/ft232r_prog /usr/local/bin/ft232r_prog
COPY --from=fwupdater-builder /dolos/fw-updater/target/release/fw-updater /usr/local/bin/fw-updater
COPY --from=dolostools /maui /usr/local/maui
RUN if [ -d /usr/local/maui/tools/scripts ]; then cp -a /usr/local/maui/tools/scripts/* /usr/local/bin/ && chmod +x /usr/local/bin/maui*; fi
RUN if [ -f /usr/local/maui/tools/requirements.txt ]; then python3 -m pip install -r /usr/local/maui/tools/requirements.txt --break-system-packages; fi
RUN if [ -f /usr/local/maui/tools/setup.py ] || [ -f /usr/local/maui/tools/pyproject.toml ]; then python3 -m pip install -e /usr/local/maui/tools --break-system-packages; fi
RUN printf '#!/bin/bash\npython3 /usr/local/maui/tools/src/maui_ctl.py "$@"\n' > /usr/local/bin/maui-ctl && chmod +x /usr/local/bin/maui-ctl
RUN printf '#!/bin/bash\npython3 /usr/local/maui/tools/src/maui_flash.py "$@"\n' > /usr/local/bin/maui-flash && chmod +x /usr/local/bin/maui-flash

WORKDIR /usr/local/server

WORKDIR /install_tmp
COPY --from=dolostools /dolos/tools/doloscmd/dist .
COPY --from=dolostools /dolos/tools/dolosbattery/dist .
COPY --from=dolostools /dolos/tools/requirements.txt .
COPY --from=hdctools-builder /hdctools/servo/firmware/usbkm/KeyboardSerial/Keyboard.hex /usr/local/server/binfiles_shadow/
RUN python3 -m pip install *.whl --no-deps --no-index --break-system-packages
RUN python3 -m pip install -r requirements.txt --require-hashes --break-system-packages

RUN rm -rf /install_tmp

RUN mkdir /usr/local/genesys/
RUN wget https://storage.googleapis.com/fwupd-cache/GenesysLogic_Google_Servo_GL3590_64.18.cab \
    -O /usr/local/genesys/GenesysLogic_GL3590_64.18.cab
WORKDIR /usr/local/servo_v4p1/
RUN wget https://storage.googleapis.com/chromeos-localmirror/distfiles/servo_v4p1_v2.0.29298-4d4a4e980.tar.xz \
    -O /usr/local/servo_v4p1/servo_v4p1_v2.0.29298-4d4a4e980.tar.xz
RUN tar xvf *
RUN rm *.tar.xz

RUN mkdir /usr/local/servo_micro/
WORKDIR /usr/local/servo_micro/
RUN wget https://storage.googleapis.com/chromeos-localmirror/distfiles/servo_micro_v2.4.82-dbed085877.tar.xz \
    -O /usr/local/servo_micro/servo_micro_v2.4.82-dbed085877.tar.xz
RUN tar xvf *
RUN rm *.tar.xz

#RUN python3 -m unittest discover -s server

RUN chmod og+w /var/log

ENV PYTHONPATH=/usr/local/maui/tools:/usr/local/maui:/usr/lib/python3/dist-packages/

EXPOSE 6002
