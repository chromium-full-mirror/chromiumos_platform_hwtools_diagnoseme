#
# Multi-target base image of the DiagnoseMe rpcserver.
#
# Every DiagnoseMe edition (see editions.json) has its own final target that
# only contains the tooling the edition needs:
#
#   base-dolos        Dolos rework (doloscmd, dolosbattery, fw-updater)
#   base-servo-v4p1   Servo v4p1 (dfu-util, dfu-programmer, fwupd, rtunicpg, ...)
#   base-servo-micro  Servo Micro (dfu-util, servo_micro firmware)
#   base-maui-v1.1    Maui v1.1 (adb, ft232r_prog; flashing via maui-utils)
#   base-all          Every tool above (development / CQ only, default target)
#
# Build a specific edition with e.g.:
#   docker build --target base-maui-v1.1 -f dockerfiles/rpcserver/Dockerfile.base .
#
# The Maui flashing tools (maui-flash, maui-ctl, fw-updater) are NOT part of
# the Maui images. They run inside the separate maui-utils container, started by the
# server through the host docker socket (see src/server/maui_utils_runner.py).

####################################################################
FROM debian:trixie AS hdctools-builder

RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    git \
    ca-certificates

WORKDIR /
RUN git clone --filter=blob:none --no-checkout --depth 1 --sparse https://chromium.googlesource.com/chromiumos/third_party/hdctools
WORKDIR /hdctools
RUN git sparse-checkout init --cone
RUN git sparse-checkout set servo/firmware/usbkm/KeyboardSerial/
RUN git checkout

######################################################################
FROM debian:trixie AS rtk-fetcher
WORKDIR /fetch
# Optional dist copy; wildcard keeps Docker from failing if absent
COPY dist/rtunicpg.tar.bz2* dist/r8152-2.21.4.tar.bz2* ./

####################################################################
FROM python:3-trixie AS dolostools

RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    git \
    apt-transport-https

WORKDIR /
RUN git clone https://chromium.googlesource.com/chromiumos/platform/dolos
RUN python3 -m pip install -r /dolos/tools/requirements.txt --require-hashes --break-system-packages

WORKDIR /dolos/tools/doloscmd
RUN python3 setup.py bdist_wheel

WORKDIR /dolos/tools/dolosbattery
RUN python3 setup.py bdist_wheel

####################################################################
# Dolos fw-updater (Dolos edition tooling).
FROM debian:trixie AS fwupdater-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    git \
    libudev-dev \
    pkg-config \
    ca-certificates

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /
RUN git clone https://chromium.googlesource.com/chromiumos/platform/dolos
WORKDIR /dolos/fw-updater
ENV USER=root
RUN cargo build --release

######################################################################
FROM debian:trixie AS rtk-tools-builder

RUN apt-get update && apt-get install -y bzip2
WORKDIR /build
COPY --from=rtk-fetcher /fetch/rtunicpg.tar.bz2* ./
RUN if [ -s rtunicpg.tar.bz2 ]; then \
        tar -xvf rtunicpg.tar.bz2 || true; \
    fi && \
    mkdir -p /build/stub && \
    touch /build/stub/rtunicpg-x86_64 /build/stub/EF8153B_stub /build/stub/EE8153B_stub

######################################################################
FROM debian:trixie AS ft232r-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libftdi-dev \
    libusb-dev \
    build-essential \
    curl \
    ca-certificates

WORKDIR /build
RUN curl -k -sSL https://rtr.ca/ft232r/ft232r_prog-1.25.tar.gz | tar -xz \
 && make -C ft232r_prog-1.25

######################################################################
FROM debian:trixie AS servo-fw-fetcher

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    ca-certificates

RUN mkdir -p /out/genesys /out/servo_v4p1 /out/servo_micro
RUN wget https://storage.googleapis.com/fwupd-cache/GenesysLogic_Google_Servo_GL3590_64.18.cab \
    -O /out/genesys/GenesysLogic_GL3590_64.18.cab
WORKDIR /out/servo_v4p1
RUN wget https://storage.googleapis.com/chromeos-localmirror/distfiles/servo_v4p1_v2.0.29298-4d4a4e980.tar.xz \
    -O servo_v4p1.tar.xz && tar xvf servo_v4p1.tar.xz && rm servo_v4p1.tar.xz
WORKDIR /out/servo_micro
RUN wget https://storage.googleapis.com/chromeos-localmirror/distfiles/servo_micro_v2.4.82-dbed085877.tar.xz \
    -O servo_micro.tar.xz && tar xvf servo_micro.tar.xz && rm servo_micro.tar.xz

#####################################################################
# Common runtime shared by every edition.
FROM python:3-trixie AS base-common

RUN apt-get update && apt-get install -yq \
    python3-docker \
    usb.ids \
    usbutils \
    libusb-1.0-0 \
    libudev1 \
    udev \
    libudev-dev

COPY dockerfiles/rpcserver/requirements.txt .
RUN python3 -m pip install -r requirements.txt --require-hashes --break-system-packages && \
    apt-get remove -y python3-protobuf || true

RUN mkdir /var/log/rpcserver
RUN mkdir /usr/local/tmp
RUN mkdir -p /usr/local/server/binfiles
RUN mkdir -p /usr/local/server/binfiles_shadow
RUN chmod og+w /var/log

ENV PYTHONPATH=/usr/lib/python3/dist-packages/

WORKDIR /usr/local/server
EXPOSE 6002

#####################################################################
FROM base-common AS base-dolos

COPY --from=fwupdater-builder /dolos/fw-updater/target/release/fw-updater /usr/local/bin/fw-updater

WORKDIR /install_tmp
COPY --from=dolostools /dolos/tools/doloscmd/dist .
COPY --from=dolostools /dolos/tools/dolosbattery/dist .
COPY --from=dolostools /dolos/tools/requirements.txt .
# PYTHONPATH (set in base-common) exposes debian dist-packages, which pip
# cannot uninstall; keep it unset while installing (as before editions).
RUN PYTHONPATH= python3 -m pip install *.whl --no-deps --no-index --break-system-packages
RUN PYTHONPATH= python3 -m pip install -r requirements.txt --require-hashes --break-system-packages
WORKDIR /usr/local/server
RUN rm -rf /install_tmp

#####################################################################
# Tooling shared by both servo editions (servod runs in its own container).
FROM base-common AS base-servo-common

RUN apt-get update && apt-get install -yq \
    dfu-util

#####################################################################
FROM base-servo-common AS base-servo-v4p1

RUN apt-get update && apt-get install -yq \
    dfu-programmer \
    libcurl3t64-gnutls \
    libxmlb2 \
    libjcat1 \
    ethtool \
    fwupd

COPY --from=rtk-tools-builder /build/*/rtunicpg-x86_64 /usr/local/bin/rtunicpg
COPY --from=rtk-tools-builder /build/*/EF8153B* /usr/local/server/binfiles_shadow/
COPY --from=rtk-tools-builder /build/*/EE8153B* /usr/local/server/binfiles_shadow/
COPY --from=hdctools-builder /hdctools/servo/firmware/usbkm/KeyboardSerial/Keyboard.hex /usr/local/server/binfiles_shadow/
COPY --from=servo-fw-fetcher /out/genesys/ /usr/local/genesys/
COPY --from=servo-fw-fetcher /out/servo_v4p1/ /usr/local/servo_v4p1/

#####################################################################
FROM base-servo-common AS base-servo-micro

COPY --from=servo-fw-fetcher /out/servo_micro/ /usr/local/servo_micro/

#####################################################################
# Tooling shared by every Maui revision. The flashing tools live in the
# maui-utils container, so only host-side discovery helpers are needed here.
FROM base-common AS base-maui-common

RUN apt-get update && apt-get install -yq \
    adb

# Docker CLI used to start maui-utils through the host docker socket.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

#####################################################################
# Maui v1.1: TI MSPM0 behind an FTDI FT232R bridge.
FROM base-maui-common AS base-maui-v1.1

RUN apt-get update && apt-get install -yq \
    libftdi1-2 \
    libftdi1

COPY --from=ft232r-builder /build/ft232r_prog-1.25/ft232r_prog /usr/local/bin/ft232r_prog

#####################################################################
# Development / CQ image containing the tooling of every edition.
# Keep last so it is the default target.
FROM base-servo-v4p1 AS base-all

RUN apt-get update && apt-get install -yq \
    adb \
    dfu-util \
    libftdi1-2 \
    libftdi1

COPY --from=ft232r-builder /build/ft232r_prog-1.25/ft232r_prog /usr/local/bin/ft232r_prog
COPY --from=servo-fw-fetcher /out/servo_micro/ /usr/local/servo_micro/
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=fwupdater-builder /dolos/fw-updater/target/release/fw-updater /usr/local/bin/fw-updater

WORKDIR /install_tmp
COPY --from=dolostools /dolos/tools/doloscmd/dist .
COPY --from=dolostools /dolos/tools/dolosbattery/dist .
COPY --from=dolostools /dolos/tools/requirements.txt .
# PYTHONPATH (set in base-common) exposes debian dist-packages, which pip
# cannot uninstall; keep it unset while installing (as before editions).
RUN PYTHONPATH= python3 -m pip install *.whl --no-deps --no-index --break-system-packages
RUN PYTHONPATH= python3 -m pip install -r requirements.txt --require-hashes --break-system-packages
WORKDIR /usr/local/server
RUN rm -rf /install_tmp
