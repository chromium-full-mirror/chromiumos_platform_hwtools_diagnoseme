##############################################################################
FROM node:25 AS protogen_node

RUN apt-get update && apt-get install --no-install-recommends -yq \
    npm

WORKDIR /workspace

COPY dockerfiles/utilities/package*.json .
RUN npm install

ENV PATH="$PATH:/workspace/node_modules/.bin"

RUN mkdir -p generated
RUN mkdir -p server
COPY src/common/protos/*.proto server/
RUN npx protoc --plugin=protoc-gen-ng=$(which protoc-gen-ng) --ng_out=./generated server/*.proto

##############################################################################

FROM python:3-trixie AS protogen_python

RUN pip3 install pip-tools
WORKDIR /workspace
COPY dockerfiles/utilities/requirements.txt .
RUN pip3 install -r requirements.txt --require-hashes --break-system-packages

RUN mkdir -p generated
RUN mkdir -p server
COPY src/common/protos/*.proto server/
RUN python3 -m grpc_tools.protoc -I. -I=$(python3 -c 'import site; print(site.getsitepackages()[0])')/grpc_tools/_proto/ --python_out=./generated --pyi_out=./generated --grpc_python_out=./generated server/*.proto


#######################################################################
FROM scratch AS copytohost

COPY --link --from=protogen_node /workspace/generated/server /
COPY --link --from=protogen_python /workspace/generated/server /
